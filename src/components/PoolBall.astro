---
// Small reusable billiard-ball icon (inline SVG, no image asset) — used for
// the "Dom's Pool" booking page (BillardContent.astro): once as a purely
// decorative hero accent, and once per table as a tab icon. A glossy radial
// gradient + a white number disc for solid-color balls; number is optional
// (the Snooker tab uses a plain red ball, since snooker reds don't carry
// numbers) so this stays a single flexible component instead of two.
interface Props {
  color: string;
  number?: string | number;
  size?: number;
  class?: string;
}
const { color, number, size = 40, class: className = '' } = Astro.props;
// Random-ish id so multiple balls on one page don't collide on the same
// <radialGradient> id (SVG ids are page-global).
const gradId = `ball-grad-${Math.random().toString(36).slice(2, 9)}`;
---
<svg viewBox="0 0 40 40" width={size} height={size} class={className} aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={gradId} cx="34%" cy="28%" r="75%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.65" />
      <stop offset="20%" stop-color={color} stop-opacity="0.95" />
      <stop offset="100%" stop-color={color} />
    </radialGradient>
  </defs>
  <circle cx="20" cy="20" r="18" fill={`url(#${gradId})`} stroke="rgba(0,0,0,0.35)" stroke-width="0.5" />
  {number !== undefined && (
    <>
      <circle cx="20" cy="20" r="8.5" fill="#fdfaf3" />
      <text x="20" y="23.2" text-anchor="middle" font-size="9.5" font-weight="700" font-family="Georgia, 'Times New Roman', serif" fill="#1a1208">{number}</text>
    </>
  )}
</svg>
