---
// Shared pizza photo-card grid — originally written inline in
// HomeContent.astro for the "best pizza in Agdal" section, now also used
// at the top of the /menu page (see MenuContent.astro) so the hero's new
// "Best pizza in Agdal" button has somewhere real to land via #pizzas.
// Same card markup either place: real dishes, real client photos, no
// stock imagery (see pizza-showcase.ts's own header comment).
import { pizzaShowcase } from '../content/pizza-showcase';
import Button from './Button.astro';
import { t, localizedPath, arrow, isRTL, type Language } from '../i18n/languages';
import { common } from '../i18n/ui';

interface Props {
  lang: Language;
  id?: string;
  kicker: string;
  title: string;
  intro: string;
  popularBadge: string;
  orderCtaHref: string;
  orderCtaLabel: string;
  /** Menu page already has its own "voir le menu complet" link elsewhere on
      the page — showing the full-menu CTA a second time right under the
      pizza grid there would be redundant, so it's only rendered on Home. */
  showMenuCta?: boolean;
}
const {
  lang,
  id,
  kicker,
  title,
  intro,
  popularBadge,
  orderCtaHref,
  orderCtaLabel,
  showMenuCta = true,
} = Astro.props;
const rtl = isRTL(lang);
---
<div class="section-tint-warm" id={id}>
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24">
    <div class="max-w-2xl mb-10 sm:mb-12" data-reveal>
      <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-2" style="color: var(--color-accent)">{kicker}</span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold" style="color: var(--color-text-primary)">{title}</h2>
      <p class="mt-3 text-sm sm:text-base leading-relaxed max-w-xl" style="color: var(--color-text-muted)">{intro}</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {pizzaShowcase.map((pizza, i) => (
        <div
          class="card-lift relative rounded-2xl overflow-hidden"
          style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${i * 70}ms`}
          data-reveal
        >
          {pizza.popular && (
            <span
              class="absolute top-3 z-10 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide"
              style={`${rtl ? 'left' : 'right'}: 0.75rem; background-color: var(--color-accent); color: var(--color-background)`}
            >
              {popularBadge}
            </span>
          )}
          <div class="photo-frame aspect-square">
            <img src={pizza.image} alt={t(pizza.imageAlt, lang)} class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="p-5">
            <h3 class="menu-item-name font-display font-semibold text-lg" style="color: var(--color-text-primary)">{pizza.name}</h3>
            <p class="text-sm mt-1.5 leading-relaxed" style="color: var(--color-text-muted)">{t(pizza.description, lang)}</p>
            <div class="flex items-center justify-between gap-3 mt-3">
              <p class="menu-item-price font-bold" style="color: var(--color-accent)">{pizza.priceMAD} MAD</p>
              <!-- Per-card order link — this grid used to only get a
                   shared CTA under the whole section, so the moment
                   someone actually settled on one pizza there was nothing
                   to click right there. -->
              <a
                href={orderCtaHref}
                target="_blank"
                rel="noreferrer"
                class="text-xs font-bold shrink-0"
                style="color: var(--color-accent)"
              >
                {orderCtaLabel} {arrow(lang)}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      {showMenuCta && (
        <Button href={localizedPath('/menu', lang)} variant="cta">
          {t(common.voirLeMenuComplet, lang)} {arrow(lang)}
        </Button>
      )}
      <a href={orderCtaHref} target="_blank" rel="noreferrer" class="text-sm font-bold" style="color: var(--color-accent)">
        {orderCtaLabel} {arrow(lang)}
      </a>
    </div>
  </section>
</div>
