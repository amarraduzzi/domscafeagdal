---
// The "best pizza in Agdal" moment — third pass. Attempt 1 was a quiet
// medal (too subtle), attempt 2 a big static starburst (still "just
// appears there, not special enough"). The brief now is a short cinematic
// beat: a round oven "window" that swings open like an actual oven door,
// with a warm light flash, and then a detailed engraved stamp slams down
// into the opening like it's just been stamped — THEN it settles into a
// normal, permanent, clickable badge. All pure CSS (transforms + one
// perspective, no JS, no video asset), so it costs nothing to load and
// plays automatically the instant the hero paints — this has to read as
// part of arriving on the page, not something a visitor has to notice on
// their own. prefers-reduced-motion skips straight to the end state (the
// landed stamp, doors already open) — no flash, no motion.
import { type Language } from '../i18n/languages';

interface Props {
  lang?: Language;
  href: string;
  class?: string;
}
const { lang = 'fr', href, class: className = '' } = Astro.props;

const label: Record<Language, string> = {
  fr: "Meilleure pizza d'Agdal",
  en: 'Best pizza in Agdal',
  ar: 'أفضل بيتزا في أكدال',
};
const ringText: Record<'fr' | 'en', string> = {
  fr: "MEILLEURE PIZZA D'AGDAL",
  en: 'BEST PIZZA IN AGDAL',
};
const centerLabel: Record<Language, string> = { fr: 'N°1', en: 'N°1', ar: 'الأفضل' };
const ariaLabel: Record<Language, string> = {
  fr: "Meilleure pizza d'Agdal — voir les avis",
  en: 'Best pizza in Agdal — see reviews',
  ar: 'أفضل بيتزا في أكدال — شاهد التقييمات',
};

const isArabic = lang === 'ar';
const loopedRingText = !isArabic ? `${ringText[lang as 'fr' | 'en']} ✦ ${ringText[lang as 'fr' | 'en']} ✦ ` : '';

// Engraved-seal detail: a ring of small tick marks around the perimeter
// (classic coin/stamp edge texture) — computed here rather than hand
// -plotted 32 times, same reasoning as the burst polygon in the previous
// version had.
const TICK_COUNT = 32;
const ticks = Array.from({ length: TICK_COUNT }, (_, i) => {
  const angle = (Math.PI * 2 * i) / TICK_COUNT;
  const x1 = 100 + 94 * Math.cos(angle);
  const y1 = 100 + 94 * Math.sin(angle);
  const x2 = 100 + 88 * Math.cos(angle);
  const y2 = 100 + 88 * Math.sin(angle);
  return { x1: x1.toFixed(1), y1: y1.toFixed(1), x2: x2.toFixed(1), y2: y2.toFixed(1) };
});
---
<div class:list={['stamp-reveal', className]}>
  <!-- Round "oven window": the glow + two swinging doors live inside this
       circularly-clipped layer so they read as one porthole rather than
       square panels with rounded corners bolted on. -->
  <div class="oven-window">
    <div class="oven-glow"></div>
    <div class="oven-door oven-door-left">
      <div class="oven-door-face">
        <span class="oven-door-grille"></span>
        <span class="oven-door-handle"></span>
      </div>
    </div>
    <div class="oven-door oven-door-right">
      <div class="oven-door-face">
        <span class="oven-door-grille"></span>
        <span class="oven-door-handle"></span>
      </div>
    </div>
  </div>

  <!-- Decorative outer frame ring, drawn on top of (not clipped by) the
       window — reads as the porthole's metal bezel, and doubles as the
       stamp's own outer edge once it lands in the same footprint. -->
  <div class="oven-bezel"></div>

  <div class="impact-ring"></div>
  <div class="impact-ring impact-ring--delay"></div>

  <a href={href} aria-label={ariaLabel[lang]} class="stamp-seal group">
    <svg viewBox="0 0 200 200" class="w-full h-full drop-shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-transform duration-300 group-hover:scale-105">
      <defs>
        <path id={`stamp-ring-path-${lang}`} d="M 100,100 m -74,0 a 74,74 0 1,1 148,0 a 74,74 0 1,1 -148,0" />
      </defs>

      <!-- Body -->
      <circle cx="100" cy="100" r="96" fill="var(--color-background)" fill-opacity="0.72" />
      <circle cx="100" cy="100" r="96" fill="none" stroke="var(--color-accent)" stroke-width="2.5" />
      <circle cx="100" cy="100" r="86" fill="none" stroke="var(--color-accent)" stroke-width="1" stroke-opacity="0.6" stroke-dasharray="2 3.5" />
      <circle cx="100" cy="100" r="62" fill="none" stroke="var(--color-accent)" stroke-width="1" stroke-opacity="0.45" />

      <!-- Engraved edge ticks -->
      {ticks.map((t) => (
        <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="var(--color-accent)" stroke-width="1.4" stroke-opacity="0.5" stroke-linecap="round" />
      ))}

      {!isArabic && (
        <text font-family="var(--font-body)" font-weight="700" font-size="10.5" letter-spacing="2" fill="var(--color-accent)">
          <textPath href={`#stamp-ring-path-${lang}`} startOffset="0%">
            {loopedRingText}
          </textPath>
        </text>
      )}

      <!-- Center mark: fixed, never rotates -->
      <g transform="translate(100 100)">
        <g transform="translate(-13 -34)" stroke="var(--color-accent)" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 2 L25 34 A26 26 0 0 1 1 34 Z" />
          <circle cx="12" cy="14" r="1.6" fill="var(--color-accent)" stroke="none" />
          <circle cx="17" cy="21" r="1.6" fill="var(--color-accent)" stroke="none" />
          <circle cx="8" cy="22" r="1.6" fill="var(--color-accent)" stroke="none" />
        </g>
        <!-- Small flanking flourishes either side of the center mark —
             the bit of extra engraving detail that reads as "official
             seal" rather than a plain sticker icon. -->
        <path d="M -34,4 Q -26,-6 -20,4 Q -26,10 -34,4 Z" fill="var(--color-accent)" fill-opacity="0.55" />
        <path d="M 34,4 Q 26,-6 20,4 Q 26,10 34,4 Z" fill="var(--color-accent)" fill-opacity="0.55" />
        <text y={isArabic ? 22 : 26} text-anchor="middle" font-family="var(--font-display)" font-weight="600" font-size={isArabic ? 13 : 14} fill="var(--color-text-primary)">
          {centerLabel[lang]}
        </text>
      </g>
    </svg>
  </a>
</div>

<style>
  .stamp-reveal {
    /* Deliberately no width/height/position rule here: an Astro scoped
       style gets an extra attribute selector added at build time, which
       beats a plain single-class Tailwind utility regardless of source
       order — the exact bug that first made this fill its whole
       positioned ancestor (width/height:100% won), then pinned it to the
       wrong corner (position:relative silently overrode the caller's
       "absolute"). Sizing AND positioning are entirely the caller's
       responsibility via the class prop; "absolute" (or "relative", or
       anything but "static") from the caller works fine as the
       containing block for this component's absolutely-positioned
       children regardless, so this rule only needs what truly can't come
       from a utility class. */
    perspective: 900px;
  }

  /* ---------- Oven window (glow + doors), clipped to a circle ---------- */
  .oven-window {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-background) 88%, black);
  }
  .oven-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(255, 170, 80, 0.95) 0%, rgba(200, 100, 30, 0.55) 45%, transparent 75%);
    opacity: 0;
    animation: oven-glow-flash 1.1s ease-out 0.2s both;
  }
  .oven-door {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background: linear-gradient(135deg, #2a2320 0%, #16110f 55%, #0b0808 100%);
    border: 1px solid rgba(201, 161, 90, 0.35);
    backface-visibility: hidden;
  }
  .oven-door-left {
    left: 0;
    transform-origin: left center;
    animation: oven-door-left-open 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.25s both;
  }
  .oven-door-right {
    right: 0;
    transform-origin: right center;
    animation: oven-door-right-open 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.25s both;
  }
  .oven-door-face {
    position: absolute;
    inset: 10%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .oven-door-grille {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(201, 161, 90, 0.3) 0px,
      rgba(201, 161, 90, 0.3) 1px,
      transparent 1px,
      transparent 8px
    );
    opacity: 0.6;
  }
  .oven-door-handle {
    position: relative;
    width: 6%;
    height: 55%;
    background: linear-gradient(180deg, #d9b877, #8a6423);
    border-radius: 9999px;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.5);
  }
  .oven-door-left .oven-door-handle {
    margin-left: auto;
    margin-right: 6%;
  }
  .oven-door-right .oven-door-handle {
    margin-right: auto;
    margin-left: 6%;
  }

  @keyframes oven-door-left-open {
    0% { transform: rotateY(0deg); }
    100% { transform: rotateY(-112deg); }
  }
  @keyframes oven-door-right-open {
    0% { transform: rotateY(0deg); }
    100% { transform: rotateY(112deg); }
  }
  @keyframes oven-glow-flash {
    0% { opacity: 0; }
    42% { opacity: 1; }
    70% { opacity: 0.4; }
    100% { opacity: 0; }
  }

  /* ---------- Decorative bezel ---------- */
  .oven-bezel {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 2px solid var(--color-accent);
    opacity: 0.9;
    pointer-events: none;
  }

  /* ---------- Impact rings at the moment the stamp lands ---------- */
  .impact-ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 2px solid var(--color-accent);
    opacity: 0;
    animation: impact-ring-pulse 0.6s ease-out 1.05s both;
  }
  .impact-ring--delay {
    animation-delay: 1.18s;
  }
  @keyframes impact-ring-pulse {
    0% { transform: scale(0.55); opacity: 0.85; }
    100% { transform: scale(1.35); opacity: 0; }
  }

  /* ---------- The stamp itself ---------- */
  .stamp-seal {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: stamp-slam 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1s both,
      stamp-idle-pulse 3.2s ease-in-out 1.5s infinite;
  }
  @keyframes stamp-slam {
    0% { transform: translateY(-46px) scale(0.35) rotate(-16deg); opacity: 0; }
    55% { transform: translateY(0) scale(1.16) rotate(-6deg); opacity: 1; }
    75% { transform: translateY(0) scale(0.94) rotate(-11deg); }
    100% { transform: translateY(0) scale(1) rotate(-9deg); opacity: 1; }
  }
  @keyframes stamp-idle-pulse {
    0%, 100% { transform: scale(1) rotate(-9deg); }
    50% { transform: scale(1.04) rotate(-7deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .oven-glow,
    .impact-ring {
      display: none;
    }
    .oven-door-left,
    .oven-door-right {
      animation: none;
      transform: rotateY(112deg);
      opacity: 0;
    }
    .stamp-seal {
      animation: none;
      opacity: 1;
      transform: rotate(-9deg);
    }
  }
</style>
