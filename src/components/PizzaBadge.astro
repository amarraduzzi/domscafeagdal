---
// The "best pizza in Agdal" seal — a circular medal/stamp badge meant to
// sit as a floating graphic in open photo space (the hero, for now).
// Built as inline SVG rather than an image: crisp at any size, themes
// itself off the same --color-accent/--color-background tokens as the
// rest of the site, and costs nothing to load.
//
// The outer ring text rotates slowly on its own axis while the center
// icon stays fixed — the classic "wax seal / vintage badge sticker"
// effect. That only works cleanly for left-to-right scripts (curved text
// along an SVG path badly distorts Arabic glyph joining), so Arabic gets
// a simpler flat variant: same circle and icon, no arced ring, no spin.
import { type Language } from '../i18n/languages';

interface Props {
  lang?: Language;
  href: string;
  class?: string;
}
const { lang = 'fr', href, class: className = '' } = Astro.props;

const ringText: Record<'fr' | 'en', string> = {
  fr: "MEILLEURE PIZZA D'AGDAL",
  en: 'BEST PIZZA IN AGDAL',
};
const centerLabel: Record<Language, string> = {
  fr: 'N°1',
  en: 'N°1',
  ar: 'الأفضل',
};
const ariaLabel: Record<Language, string> = {
  fr: "Meilleure pizza d'Agdal — voir les avis",
  en: 'Best pizza in Agdal — see reviews',
  ar: 'أفضل بيتزا في أكدال — شاهد التقييمات',
};

const isArabic = lang === 'ar';
// SVG textPath needs the ring phrase repeated (with a separator) to wrap
// the full 360° circle rather than bunching in one arc.
const loopedRingText = !isArabic ? `${ringText[lang as 'fr' | 'en']} ✦ ${ringText[lang as 'fr' | 'en']} ✦ ` : '';
---
<a
  href={href}
  aria-label={ariaLabel[lang]}
  class:list={['pizza-badge group inline-flex items-center justify-center', className]}
>
  <svg viewBox="0 0 200 200" class="w-full h-full drop-shadow-[0_8px_20px_rgba(0,0,0,0.5)] transition-transform duration-300 group-hover:scale-105">
    <defs>
      <path id={`badge-ring-path-${lang}`} d="M 100,100 m -78,0 a 78,78 0 1,1 156,0 a 78,78 0 1,1 -156,0" />
    </defs>

    <!-- Base disc + double ring, the "seal" body -->
    <circle cx="100" cy="100" r="96" fill="var(--color-background)" fill-opacity="0.55" />
    <circle cx="100" cy="100" r="96" fill="none" stroke="var(--color-accent)" stroke-width="2" />
    <circle cx="100" cy="100" r="86" fill="none" stroke="var(--color-accent)" stroke-width="1" stroke-opacity="0.55" stroke-dasharray="2.5 4" />

    {!isArabic && (
      <g class="pizza-badge-ring">
        <text font-family="var(--font-body)" font-weight="700" font-size="11.5" letter-spacing="2.5" fill="var(--color-accent)">
          <textPath href={`#badge-ring-path-${lang}`} startOffset="0%">
            {loopedRingText}
          </textPath>
        </text>
      </g>
    )}

    <!-- Center mark: fixed, never rotates — a simple line-art pizza slice
         (same stroke weight/style as the site's other inline icons, e.g.
         Home's "why us" and Contact's info-row icons) plus a short label. -->
    <g transform="translate(100 100)">
      <g transform="translate(-13 -30)" stroke="var(--color-accent)" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 2 L25 34 A26 26 0 0 1 1 34 Z" />
        <circle cx="12" cy="14" r="1.6" fill="var(--color-accent)" stroke="none" />
        <circle cx="17" cy="21" r="1.6" fill="var(--color-accent)" stroke="none" />
        <circle cx="8" cy="22" r="1.6" fill="var(--color-accent)" stroke="none" />
      </g>
      <text
        y={isArabic ? 12 : 16}
        text-anchor="middle"
        font-family="var(--font-display)"
        font-weight="600"
        font-size={isArabic ? 13 : 15}
        fill="var(--color-text-primary)"
      >
        {centerLabel[lang]}
      </text>
    </g>
  </svg>
</a>

<style>
  .pizza-badge {
    display: inline-flex;
    border-radius: 9999px;
  }
  /* Slow, continuous spin on the ring text only — the center mark (drawn
     in a separate, non-rotated <g>) stays upright and readable the whole
     time. Transform-origin needs to be the SVG's own center (100 100),
     not the element's visual box, hence the explicit box + origin. */
  .pizza-badge-ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: pizza-badge-spin 22s linear infinite;
  }
  @keyframes pizza-badge-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pizza-badge-ring { animation: none; }
  }
</style>
