---
// The "best pizza in Agdal" moment — fourth pass. Attempt 1 was a quiet
// medal (too subtle), attempt 2 a big static starburst ("nog niet
// speciaal genoeg"), attempt 3 gave THIS component its own small round
// oven-door-and-stamp effect. The client's next round of feedback moved
// the oven doors to cover the ENTIRE hero photo instead (see
// .oven-doors-big in HomeContent.astro) — so this component no longer
// needs its own oven window/doors/glow, it's purely the detailed stamp
// that slams down once the hero-wide doors have swung open. Its slam
// timing is deliberately delayed (see the animation-delay values below)
// to start right as those big doors finish, so the two effects read as
// one continuous beat instead of two separate animations.
//
// Also new this pass: the center graphic is a large, unmistakable
// top-down pizza (crust ring, cut lines, pepperoni) instead of the
// previous small abstract slice icon — the brief was explicit that the
// pizza itself needs to be "grafisch en heel duidelijk", not just implied
// by the ring text. Still pure CSS + inline SVG, no JS, no video asset.
// prefers-reduced-motion skips straight to the landed, settled stamp.
import { type Language } from '../i18n/languages';

interface Props {
  lang?: Language;
  href: string;
  class?: string;
}
const { lang = 'fr', href, class: className = '' } = Astro.props;

const label: Record<Language, string> = {
  fr: "Meilleure pizza d'Agdal",
  en: 'Best pizza in Agdal',
  ar: 'أفضل بيتزا في أكدال',
};
const ringText: Record<'fr' | 'en', string> = {
  fr: "MEILLEURE PIZZA D'AGDAL",
  en: 'BEST PIZZA IN AGDAL',
};
const centerLabel: Record<Language, string> = { fr: 'N°1', en: 'N°1', ar: 'الأفضل' };
const ariaLabel: Record<Language, string> = {
  fr: "Meilleure pizza d'Agdal — voir les avis",
  en: 'Best pizza in Agdal — see reviews',
  ar: 'أفضل بيتزا في أكدال — شاهد التقييمات',
};

const isArabic = lang === 'ar';
const loopedRingText = !isArabic ? `${ringText[lang as 'fr' | 'en']} ✦ ${ringText[lang as 'fr' | 'en']} ✦ ` : '';

// Engraved-seal detail: a ring of small tick marks around the perimeter
// (classic coin/stamp edge texture) — computed here rather than hand
// -plotted 32 times, same reasoning as the pizza's own cut lines/
// pepperoni spots below.
const TICK_COUNT = 32;
const ticks = Array.from({ length: TICK_COUNT }, (_, i) => {
  const angle = (Math.PI * 2 * i) / TICK_COUNT;
  const x1 = 100 + 94 * Math.cos(angle);
  const y1 = 100 + 94 * Math.sin(angle);
  const x2 = 100 + 88 * Math.cos(angle);
  const y2 = 100 + 88 * Math.sin(angle);
  return { x1: x1.toFixed(1), y1: y1.toFixed(1), x2: x2.toFixed(1), y2: y2.toFixed(1) };
});

// The pizza itself — a big, literal top-down pizza (crust ring + 8 cut
// lines + scattered pepperoni), kept fully monochrome (var(--color-accent)
// at varying opacity) so it still reads as part of the stamp's engraving
// rather than a colored sticker dropped on top of it. Radius 48 against
// the stamp's own r=96 body means the pizza fills roughly half the seal —
// impossible to miss at a glance, which is the whole point after the
// previous version's icon read as "some kind of leaf".
const PIZZA_R = 48;
const cutLines = [0, 45, 90, 135, 180, 225, 270, 315].map((deg) => {
  const rad = (deg * Math.PI) / 180;
  return { x2: (PIZZA_R * Math.cos(rad)).toFixed(1), y2: (PIZZA_R * Math.sin(rad)).toFixed(1) };
});
const pepperoni = [
  { cx: -18, cy: -22 },
  { cx: 20, cy: -18 },
  { cx: 28, cy: 10 },
  { cx: 10, cy: 30 },
  { cx: -15, cy: 28 },
  { cx: -30, cy: 2 },
  { cx: 2, cy: -32 },
];
---
<div class:list={['stamp-reveal', className]}>
  <!-- Decorative outer frame ring — the stamp's own bezel/edge. Hidden
       behind the hero-wide oven doors until they open (see
       HomeContent.astro), so it doesn't need its own reveal animation:
       it's simply already there the moment the doors clear, like the
       stamp's holder was sitting in the opening the whole time. -->
  <div class="stamp-frame"></div>

  <div class="impact-ring"></div>
  <div class="impact-ring impact-ring--delay"></div>

  <a href={href} aria-label={ariaLabel[lang]} class="stamp-seal group">
    <svg viewBox="0 0 200 200" class="w-full h-full drop-shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-transform duration-300 group-hover:scale-105">
      <defs>
        <path id={`stamp-ring-path-${lang}`} d="M 100,100 m -74,0 a 74,74 0 1,1 148,0 a 74,74 0 1,1 -148,0" />
      </defs>

      <!-- Body -->
      <circle cx="100" cy="100" r="96" fill="var(--color-background)" fill-opacity="0.72" />
      <circle cx="100" cy="100" r="96" fill="none" stroke="var(--color-accent)" stroke-width="2.5" />
      <circle cx="100" cy="100" r="86" fill="none" stroke="var(--color-accent)" stroke-width="1" stroke-opacity="0.6" stroke-dasharray="2 3.5" />

      <!-- Engraved edge ticks -->
      {ticks.map((t) => (
        <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="var(--color-accent)" stroke-width="1.4" stroke-opacity="0.5" stroke-linecap="round" />
      ))}

      {!isArabic && (
        <text font-family="var(--font-body)" font-weight="700" font-size="10.5" letter-spacing="2" fill="var(--color-accent)">
          <textPath href={`#stamp-ring-path-${lang}`} startOffset="0%">
            {loopedRingText}
          </textPath>
        </text>
      )}

      <!-- Center graphic: the pizza — fixed, never rotates -->
      <g transform="translate(100 100)">
        <circle r={PIZZA_R} fill="var(--color-accent)" fill-opacity="0.16" stroke="var(--color-accent)" stroke-width="4" />
        <circle r={PIZZA_R - 6} fill="none" stroke="var(--color-accent)" stroke-width="1" stroke-opacity="0.55" stroke-dasharray="1.5 4" />
        {cutLines.map((c) => (
          <line x1="0" y1="0" x2={c.x2} y2={c.y2} stroke="var(--color-accent)" stroke-width="1" stroke-opacity="0.4" />
        ))}
        {pepperoni.map((p) => (
          <circle cx={p.cx} cy={p.cy} r="4.4" fill="var(--color-accent)" fill-opacity="0.85" />
        ))}
        <!-- Small ribbon banner for the N°1 / الأفضل mark, sitting in the
             gap between the pizza's edge and the ring text so the two
             pieces of type never compete for the same space. -->
        <rect x="-30" y="56" width="60" height="18" rx="3" fill="var(--color-background)" fill-opacity="0.85" stroke="var(--color-accent)" stroke-width="1" />
        <text y={isArabic ? 68.5 : 69} text-anchor="middle" font-family="var(--font-display)" font-weight="600" font-size={isArabic ? 12 : 12.5} fill="var(--color-text-primary)">
          {centerLabel[lang]}
        </text>
      </g>
    </svg>
  </a>
</div>

<style>
  .stamp-reveal {
    /* Deliberately no width/height/position rule here: an Astro scoped
       style gets an extra attribute selector added at build time, which
       beats a plain single-class Tailwind utility regardless of source
       order — the exact bug that first made this fill its whole
       positioned ancestor (width/height:100% won), then pinned it to the
       wrong corner (position:relative silently overrode the caller's
       "absolute"). Sizing AND positioning are entirely the caller's
       responsibility via the class prop. */
  }

  /* ---------- Decorative bezel behind the stamp ---------- */
  .stamp-frame {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 2px solid var(--color-accent);
    opacity: 0.9;
    pointer-events: none;
  }

  /* ---------- Impact rings at the moment the stamp lands ---------- */
  /* Delays pushed back ~0.5s from the previous (v3) timing so they fire
     right as the hero-wide oven doors (1.1s animation + 0.35s delay =
     ~1.45s to fully open) finish, instead of mid-swing. */
  .impact-ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 2px solid var(--color-accent);
    opacity: 0;
    animation: impact-ring-pulse 0.6s ease-out 1.55s both;
  }
  .impact-ring--delay {
    animation-delay: 1.68s;
  }
  @keyframes impact-ring-pulse {
    0% { transform: scale(0.55); opacity: 0.85; }
    100% { transform: scale(1.35); opacity: 0; }
  }

  /* ---------- The stamp itself ---------- */
  .stamp-seal {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: stamp-slam 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.5s both,
      stamp-idle-pulse 3.2s ease-in-out 2s infinite;
  }
  @keyframes stamp-slam {
    0% { transform: translateY(-46px) scale(0.35) rotate(-16deg); opacity: 0; }
    55% { transform: translateY(0) scale(1.16) rotate(-6deg); opacity: 1; }
    75% { transform: translateY(0) scale(0.94) rotate(-11deg); }
    100% { transform: translateY(0) scale(1) rotate(-9deg); opacity: 1; }
  }
  @keyframes stamp-idle-pulse {
    0%, 100% { transform: scale(1) rotate(-9deg); }
    50% { transform: scale(1.04) rotate(-7deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .impact-ring {
      display: none;
    }
    .stamp-seal {
      animation: none;
      opacity: 1;
      transform: rotate(-9deg);
    }
  }
</style>
