---
// Dom's Café logo — real logo file supplied by the client (cup + pizza
// mark, "Dom's Café • Pizzeria" wordmark), stored locally with its
// background made transparent so it sits cleanly on the header at any
// scroll state (transparent, then the surface color once scrolled).
import { siteConfig } from '../config/site.config';
import { getOrderCtaLabel } from '../lib/nav';
import { LANGUAGES, LANGUAGE_LABEL, LANGUAGE_NATIVE_NAME, localizedPath, arrow, t, type Language } from '../i18n/languages';
import { nav as navUi } from '../i18n/ui';

interface Props {
  lang?: Language;
  minimal?: boolean;
}
const { lang = 'fr', minimal = false } = Astro.props;
const orderCta = getOrderCtaLabel(lang);

const nav = [
  { href: '/', label: t(navUi.accueil, lang) },
  { href: '/menu', label: t(navUi.menu, lang) },
  { href: '/pizza', label: t(navUi.pizza, lang) },
  { href: '/billard', label: t(navUi.billard, lang) },
  { href: '/a-propos', label: t(navUi.aPropos, lang) },
  { href: '/avis', label: t(navUi.avis, lang) },
  { href: '/faq', label: t(navUi.faq, lang) },
  { href: '/contact', label: t(navUi.contact, lang) },
].map((item) => ({ ...item, href: localizedPath(item.href, lang) }));

const currentPath = Astro.url.pathname;
const langLinks = LANGUAGES.map((l) => ({ lang: l, href: localizedPath(currentPath, l) }));
---
<header id="site-header" class="sticky top-0 z-40 transition-all duration-300" data-scrolled="false">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-4">
    <a href={localizedPath('/', lang)} class="flex items-center gap-2 min-w-0 shrink">
      <img src="/images/dom/logo.webp" alt={siteConfig.identity.name} class="h-10 sm:h-12 w-auto object-contain" />
    </a>

    {!minimal && (
      <nav class="hidden lg:flex items-center gap-6 shrink-0">
        {nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-semibold transition-colors"
            style={`color: ${currentPath === item.href ? 'var(--color-primary)' : 'var(--color-text-primary)'}`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    )}

    <!-- Desktop only: the original always-visible pill row. Untouched —
         the request was specifically about the mobile layout, where three
         pills were competing with the logo for header width. -->
    <div class="hidden lg:flex items-center gap-0.5 sm:gap-1 shrink-0 rounded-full p-0.5" style="border: 1px solid var(--color-border)">
      {langLinks.map((l) => (
        <a
          href={l.href}
          aria-label={LANGUAGE_NATIVE_NAME[l.lang]}
          aria-current={lang === l.lang ? 'true' : undefined}
          class="px-1.5 sm:px-2 py-1 rounded-full text-[11px] sm:text-xs font-bold transition-colors"
          style={`color: ${lang === l.lang ? 'var(--color-background)' : 'var(--color-text-muted)'}; background-color: ${lang === l.lang ? 'var(--color-primary)' : 'transparent'}`}
        >
          {LANGUAGE_LABEL[l.lang]}
        </a>
      ))}
    </div>

    {!minimal && (
      <!-- Phone icon — "Nous appeler" used to be a full button in the Home
           hero; the client wants that hero slot for the pizza push instead
           (see HomeContent.astro), so calling moved here: one tap away in
           the header on every page, not gone from the site. Icon-only
           (title attr for a11y/tooltip) so it doesn't compete for width
           with the order link next to it. -->
      <a
        href={siteConfig.contact.phoneHref}
        aria-label={t(navUi.contact, lang)}
        title={siteConfig.contact.phoneDisplay}
        class="hidden sm:inline-flex items-center justify-center w-9 h-9 rounded-full shrink-0 transition-colors"
        style="border: 1px solid var(--color-border); color: var(--color-text-primary)"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
      </a>
    )}

    {!minimal && (
      <a
        href={orderCta.href}
        target="_blank"
        rel="noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 text-sm font-bold shrink-0"
        style="color: var(--color-primary)"
      >
        {orderCta.label} {arrow(lang)}
      </a>
    )}

    {!minimal && (
      <!-- Mobile only: one compact "current language" trigger sitting
           right next to the hamburger, instead of three permanent pills.
           Tapping it drops down the other two choices — same idea as the
           hamburger's own panel, just a smaller one anchored under this
           button. -->
      <div class="lg:hidden relative shrink-0 flex items-center gap-2">
        <button
          id="lang-switch-toggle"
          class="flex items-center gap-1 rounded-full pl-2.5 pr-1.5 py-1 text-[11px] font-bold transition-colors"
          style="border: 1px solid var(--color-border); color: var(--color-text-primary)"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={LANGUAGE_NATIVE_NAME[lang]}
        >
          {LANGUAGE_LABEL[lang]}
          <svg id="lang-switch-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform duration-200" style="color: var(--color-accent)">
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div
          id="lang-switch-panel"
          class="hidden flex-col absolute right-0 top-full mt-2 py-1 rounded-xl overflow-hidden min-w-[8rem] z-50"
          style="background-color: var(--color-surface); border: 1px solid var(--color-border); box-shadow: 0 12px 28px rgba(0,0,0,0.45)"
        >
          {langLinks.map((l) => (
            <a
              href={l.href}
              aria-current={lang === l.lang ? 'true' : undefined}
              class="px-4 py-2.5 text-sm font-semibold transition-colors"
              style={`color: ${lang === l.lang ? 'var(--color-accent)' : 'var(--color-text-primary)'}`}
            >
              {LANGUAGE_NATIVE_NAME[l.lang]}
            </a>
          ))}
        </div>

        <button id="mobile-nav-toggle" class="shrink-0" aria-label="Menu" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color: var(--color-text-primary)">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    )}
  </div>

  {!minimal && (
    <div id="mobile-nav-panel" class="lg:hidden hidden flex-col px-4 pb-4" style="background-color: var(--color-surface)">
      {nav.map((item) => (
        <a href={item.href} class="py-2.5 text-sm font-semibold" style="color: var(--color-text-primary)">
          {item.label}
        </a>
      ))}
      <a
        href={orderCta.href}
        target="_blank"
        rel="noreferrer"
        class="mt-3 pt-3 py-2.5 text-sm font-bold"
        style="border-top: 1px solid var(--color-border); color: var(--color-primary)"
      >
        {orderCta.label} {arrow(lang)}
      </a>
      <a href={siteConfig.contact.phoneHref} class="flex items-center gap-1.5 py-2.5 text-sm font-semibold" style="color: var(--color-text-primary)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent)">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        {siteConfig.contact.phoneDisplay}
      </a>
    </div>
  )}

  <div class="h-px w-full transition-colors duration-300" id="header-track">
    <div id="header-progress" class="h-full" style="width: 0%; background-color: var(--color-primary)"></div>
  </div>
</header>

<style>
  #site-header {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }
  #site-header[data-scrolled='true'] {
    background-color: color-mix(in srgb, var(--color-surface) 95%, transparent);
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }
  #header-track {
    background-color: transparent;
  }
  #site-header[data-scrolled='true'] #header-track {
    background-color: var(--color-border);
  }
  #mobile-nav-panel.open {
    display: flex;
  }
</style>

<script>
  let scrollHandler: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    const header = document.getElementById('site-header');
    const progress = document.getElementById('header-progress');
    const toggle = document.getElementById('mobile-nav-toggle');
    const panel = document.getElementById('mobile-nav-panel');
    const langToggle = document.getElementById('lang-switch-toggle');
    const langPanel = document.getElementById('lang-switch-panel');
    const langCaret = document.getElementById('lang-switch-caret');

    function closeLangPanel() {
      langPanel?.classList.add('hidden');
      langPanel?.classList.remove('flex');
      langToggle?.setAttribute('aria-expanded', 'false');
      langCaret?.style.setProperty('transform', 'rotate(0deg)');
    }

    langToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = langPanel?.classList.contains('hidden');
      if (isHidden) {
        langPanel?.classList.remove('hidden');
        langPanel?.classList.add('flex');
        langToggle.setAttribute('aria-expanded', 'true');
        langCaret?.style.setProperty('transform', 'rotate(180deg)');
        // Closing the hamburger's own nav panel when the language dropdown
        // opens — both are absolutely positioned near each other and
        // having both open at once on a small screen looks cluttered.
        panel?.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      } else {
        closeLangPanel();
      }
    });

    // Any click outside the dropdown closes it — otherwise it stays open
    // forever once opened, since it isn't inside a <form> or anything with
    // native dismiss behavior.
    document.addEventListener('click', (e) => {
      if (langPanel && !langPanel.classList.contains('hidden') && !langPanel.contains(e.target as Node) && e.target !== langToggle) {
        closeLangPanel();
      }
    });

    function onScroll() {
      if (!header || !progress) return;
      const scrolled = window.scrollY > 8;
      header.dataset.scrolled = String(scrolled);
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const pct = max > 0 ? Math.min(1, window.scrollY / max) : 0;
      progress.style.width = `${pct * 100}%`;
    }
    onScroll();

    if (scrollHandler) window.removeEventListener('scroll', scrollHandler);
    scrollHandler = onScroll;
    window.addEventListener('scroll', scrollHandler, { passive: true });

    toggle?.addEventListener('click', () => {
      const isOpen = panel?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
      if (isOpen) closeLangPanel();
    });
  });
</script>
