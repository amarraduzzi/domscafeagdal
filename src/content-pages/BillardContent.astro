---
// "Dom's Pool" table booking (client request, see chat — the client sent
// real photos of the room and wants a self-service, 30-minute-slot booking
// system for the 2 pool tables + 1 snooker table, shown on a screen in the
// café and bookable by guests on their own phone via a QR code). Same
// architecture as the Indian Flavors reservation system this client also
// commissioned: a Supabase project called directly from the browser via
// plain `fetch` to its REST/PostgREST endpoint — no server of our own, no
// new npm dependency, this stays a fully static site. See
// doms_pool_setup.sql (given to the client separately) for the table
// schema + RLS policies + column grants this page relies on: guests can
// INSERT a booking and SELECT (table, date, time, name) but never phone
// numbers — those stay staff-only, readable in the Supabase dashboard.
//
// Staff booking a walk-in: client explicitly chose "same form as guests"
// for v1 (see chat) rather than a separate login-gated staff view — so
// this one page serves both, typically opened on a tablet/the lobby
// screen's browser for staff, and via the QR code on the screen for guests.
//
// Cancelling: clicking an already-booked slot prompts for the staff PIN
// (site.config.ts's billiards.staffCancelPin) and, if correct, deletes that
// booking after a confirm(). This is a UI deterrent only — see the PIN's
// own comment in site.config.ts for why it isn't real access control in
// this no-login v1.
//
// Mobile-first redesign (client: "wordt voornamelijk op mobiel bekeken"):
// the old layout was a single 3-column x ~30-row table — usable on desktop
// but a scroll-heavy, horizontally-scrolling mess on a phone screen reached
// via the QR code. Replaced with the pattern most booking apps use on
// mobile: a horizontally-scrollable strip of date chips, a 3-way table tab
// (one at a time, full-width rows — no more horizontal table scroll), and
// today's already-past times collapsed by default so the list opens on the
// next actually-bookable slot instead of a wall of greyed-out "Passé" rows.
// PoolBall.astro supplies the decorative + tab-icon billiard balls the
// client asked to see worked into the page.
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PoolBall from '../components/PoolBall.astro';
import { siteConfig } from '../config/site.config';
import { t, localizedPath, type Language } from '../i18n/languages';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name } = siteConfig.identity;
const { tables, slotMinutes, supabaseUrl, supabaseAnonKey, staffCancelPin } = siteConfig.billiards;
const { open, close } = siteConfig.contact.hours;

// Not yet wired up to a real Supabase project (see site.config.ts's own
// comment) — render an honest "coming soon" state instead of shipping a
// page that silently fails every fetch call.
const isConfigured = !supabaseUrl.includes('YOUR-PROJECT-REF') && !supabaseAnonKey.includes('YOUR-ANON-KEY');

// Ball colour/number per table — purely visual (tab icons + nothing to do
// with the real, differently-numbered pool ball set). Snooker gets a plain
// red ball with no number since snooker's reds don't carry one.
const ballStyles: Record<string, { color: string; number?: string }> = {
  pool_1: { color: '#F2C230', number: '1' },
  pool_2: { color: '#2E6FB0', number: '2' },
  snooker: { color: '#B23A2E' },
};

// Time slots as "HH:MM" strings from opening to closing, one entry per
// `slotMinutes` — computed once here instead of hand-typed, so a future
// change to opening hours or slot length (site.config.ts / siteConfig)
// updates this automatically. The LAST slot's start still leaves a full
// slot before closing (e.g. closing at 23:00 with 30-min slots means the
// last bookable start is 22:30, not 23:00).
function pad(n: number) {
  return n.toString().padStart(2, '0');
}
const slots: { start: string; end: string }[] = [];
for (let mins = open * 60; mins + slotMinutes <= close * 60; mins += slotMinutes) {
  const startH = Math.floor(mins / 60);
  const startM = mins % 60;
  const endMins = mins + slotMinutes;
  const endH = Math.floor(endMins / 60);
  const endM = endMins % 60;
  slots.push({ start: `${pad(startH)}:${pad(startM)}`, end: `${pad(endH)}:${pad(endM)}` });
}

const copy = {
  metaTitle: {
    fr: `Réserver un billard ou le snooker — Dom's Pool | ${name}`,
    en: `Book a pool or snooker table — Dom's Pool | ${name}`,
    ar: `احجز طاولة بيلياردو أو سنوكر — Dom's Pool | ${name}`,
  },
  metaDescription: {
    fr: `Réservez en ligne l'une des 2 tables de billard ou la table de snooker de Dom's Pool, par créneau de ${slotMinutes} minutes. Paiement sur place.`,
    en: `Book one of Dom's Pool's 2 pool tables or the snooker table online, in ${slotMinutes}-minute slots. Pay on site.`,
    ar: `احجز إحدى طاولتي البيلياردو أو طاولة السنوكر في Dom's Pool عبر الإنترنت، بفترات ${slotMinutes} دقيقة. الدفع في المكان.`,
  },
  kicker: { fr: "Dom's Pool", en: "Dom's Pool", ar: "Dom's Pool" },
  title: { fr: 'Réserver une table', en: 'Book a table', ar: 'احجز طاولة' },
  intro: {
    fr: `Choisissez une table et un créneau de ${slotMinutes} minutes. Paiement sur place, comme d'habitude — la réservation garantit juste que la table est à vous.`,
    en: `Choose a table and a ${slotMinutes}-minute slot. Pay on site as usual — the booking just guarantees the table is yours.`,
    ar: `اختر طاولة وفترة ${slotMinutes} دقيقة. الدفع في المكان كالمعتاد — الحجز يضمن فقط أن الطاولة لك.`,
  },
  dateLabel: { fr: 'Date', en: 'Date', ar: 'التاريخ' },
  todayLabel: { fr: "Aujourd'hui", en: 'Today', ar: 'اليوم' },
  loading: { fr: 'Chargement des disponibilités…', en: 'Loading availability…', ar: 'جارٍ تحميل الأوقات المتاحة…' },
  free: { fr: 'Libre', en: 'Free', ar: 'متاحة' },
  bookedBy: { fr: 'Réservé', en: 'Booked', ar: 'محجوزة' },
  past: { fr: 'Passé', en: 'Past', ar: 'منتهية' },
  showPast: { fr: 'Afficher les heures passées', en: 'Show past times', ar: 'إظهار الأوقات السابقة' },
  hidePast: { fr: 'Masquer les heures passées', en: 'Hide past times', ar: 'إخفاء الأوقات السابقة' },
  formTitle: { fr: 'Confirmer la réservation', en: 'Confirm the booking', ar: 'تأكيد الحجز' },
  nameLabel: { fr: 'Nom', en: 'Name', ar: 'الاسم' },
  phoneLabel: { fr: 'Téléphone', en: 'Phone', ar: 'الهاتف' },
  confirmCta: { fr: 'Confirmer', en: 'Confirm', ar: 'تأكيد' },
  cancelCta: { fr: 'Annuler', en: 'Cancel', ar: 'إلغاء' },
  successMessage: { fr: 'Réservé ! À bientôt.', en: 'Booked! See you soon.', ar: 'تم الحجز! نراكم قريبًا.' },
  takenMessage: {
    fr: "Ce créneau vient d'être pris par quelqu'un d'autre — choisissez-en un autre.",
    en: 'This slot was just taken by someone else — please pick another one.',
    ar: 'تم للتو حجز هذه الفترة من قبل شخص آخر — يرجى اختيار فترة أخرى.',
  },
  errorMessage: {
    fr: "Une erreur est survenue, réessayez ou contactez-nous directement.",
    en: 'Something went wrong — please try again or contact us directly.',
    ar: 'حدث خطأ، يرجى المحاولة مرة أخرى أو التواصل معنا مباشرة.',
  },
  nameRequired: { fr: 'Le nom est obligatoire.', en: 'Name is required.', ar: 'الاسم مطلوب.' },
  phoneRequired: { fr: 'Le téléphone est obligatoire.', en: 'Phone number is required.', ar: 'رقم الهاتف مطلوب.' },
  cancelPinPrompt: {
    fr: 'Code personnel pour annuler cette réservation :',
    en: 'Staff PIN to cancel this booking:',
    ar: 'رمز الموظف لإلغاء هذا الحجز:',
  },
  cancelWrongPin: { fr: 'Code incorrect.', en: 'Incorrect PIN.', ar: 'رمز غير صحيح.' },
  cancelConfirmPrefix: {
    fr: 'Annuler la réservation de',
    en: 'Cancel the booking for',
    ar: 'إلغاء حجز',
  },
  cancelSuccess: { fr: 'Réservation annulée.', en: 'Booking cancelled.', ar: 'تم إلغاء الحجز.' },
  comingSoonTitle: { fr: 'Bientôt disponible', en: 'Coming soon', ar: 'قريبًا' },
  comingSoonBody: {
    fr: "La réservation en ligne des tables arrive très bientôt. En attendant, demandez au bar quelle table est libre.",
    en: 'Online table booking is launching very soon. In the meantime, ask at the counter which table is free.',
    ar: 'الحجز الإلكتروني للطاولات قادم قريبًا جدًا. في الأثناء، اسأل عند الطاولة عن الطاولة المتاحة.',
  },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

// Locale used for the date chips' weekday labels (Intl.toLocaleDateString) —
// same fr/en/ar → locale mapping convention as the rest of the site.
const dateLocale = { fr: 'fr-FR', en: 'en-US', ar: 'ar-MA' }[lang];

const path = localizedPath('/billard', lang);
---
<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
>
  <section class="max-w-5xl mx-auto px-5 sm:px-8 pt-12 sm:pt-16 pb-4 text-center">
    <div class="flex items-center justify-center gap-2 mb-3" data-reveal="scale">
      <PoolBall color="#1a1208" number="8" size={46} />
      <PoolBall color="#C9A15A" number="9" size={32} class="opacity-90 -mb-2" />
    </div>
    <span class="block text-[10px] font-bold uppercase tracking-[0.3em] mb-2" style="color: var(--color-accent)">{t(copy.kicker, lang)}</span>
    <h1 class="font-display text-3xl sm:text-5xl font-semibold" style="color: var(--color-text-primary)">{t(copy.title, lang)}</h1>
    <p class="mt-3 max-w-xl mx-auto text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)">{t(copy.intro, lang)}</p>
  </section>

  {!isConfigured ? (
    <section class="max-w-2xl mx-auto px-5 sm:px-8 pb-24">
      <div class="rounded-2xl p-8 text-center" style="background-color: var(--color-surface); border: 1px solid var(--color-border)">
        <h2 class="font-display text-xl font-semibold mb-2" style="color: var(--color-text-primary)">{t(copy.comingSoonTitle, lang)}</h2>
        <p class="text-sm" style="color: var(--color-text-muted)">{t(copy.comingSoonBody, lang)}</p>
      </div>
    </section>
  ) : (
    <section id="billard-app" class="max-w-lg mx-auto px-5 sm:px-8 pb-24" data-slot-minutes={slotMinutes}>
      <!-- Date chips: a horizontally-scrollable strip (today + 6 days)
           replaces the old native <input type="date"> — much faster to tap
           through on a phone than opening the OS date picker for what's
           almost always "today" or "tomorrow" anyway. -->
      <p class="text-xs font-bold uppercase tracking-wide mb-2" style="color: var(--color-accent)">{t(copy.dateLabel, lang)}</p>
      <div id="billard-date-chips" class="flex gap-2 overflow-x-auto pb-1 mb-5" style="scrollbar-width: none;"></div>

      <!-- Table tabs: one table's list shown at a time (see the panels
           below) instead of 3 cramped columns — the thing that made the old
           layout require horizontal scrolling on any phone. -->
      <div id="billard-table-tabs" class="grid grid-cols-3 gap-2 mb-5">
        {tables.map((table) => (
          <button
            type="button"
            class="billard-table-tab flex flex-col items-center justify-center gap-1.5 rounded-2xl px-2 py-3 text-xs font-bold transition-colors"
            data-table={table.id}
            style="border: 1px solid var(--color-border)"
          >
            <PoolBall color={ballStyles[table.id].color} number={ballStyles[table.id].number} size={26} />
            <span>{t(table.label, lang)}</span>
          </button>
        ))}
      </div>

      <p id="billard-status" class="text-sm mb-3" style="color: var(--color-text-muted)">{t(copy.loading, lang)}</p>

      <button type="button" id="billard-toggle-past" class="hidden text-xs font-semibold underline mb-3" style="color: var(--color-text-muted)"></button>

      <div id="billard-slot-lists">
        {tables.map((table) => (
          <div class="billard-table-panel space-y-2" data-table={table.id} hidden>
            {slots.map((slot) => (
              <button
                type="button"
                class="billard-slot w-full flex items-center justify-between gap-3 rounded-xl px-4 py-3.5 text-sm font-bold transition-colors text-left rtl:text-right"
                data-table={table.id}
                data-start={slot.start}
                data-end={slot.end}
                style="background-color: color-mix(in srgb, var(--color-accent) 14%, transparent); color: var(--color-accent)"
              >
                <span class="slot-time whitespace-nowrap" dir="ltr">{slot.start} – {slot.end}</span>
                <span class="slot-status text-xs font-semibold text-right rtl:text-left">{t(copy.free, lang)}</span>
              </button>
            ))}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Booking form overlay — plain hidden/flex toggle rather than <dialog>,
       to avoid a11y/polyfill inconsistencies across the three RTL/LTR
       layouts this site ships. Stays in the DOM always; only its
       visibility and the slot summary text change. -->
  <div id="billard-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" style="background-color: rgba(10,6,3,0.72)">
    <div class="w-full max-w-sm rounded-2xl p-6" style="background-color: var(--color-surface); border: 1px solid var(--color-border)">
      <h2 class="font-display text-lg font-semibold mb-1" style="color: var(--color-text-primary)">{t(copy.formTitle, lang)}</h2>
      <p id="billard-modal-summary" class="text-sm mb-4" style="color: var(--color-accent)"></p>
      <form id="billard-form" class="space-y-3">
        <div>
          <label for="billard-name" class="block text-xs font-bold uppercase tracking-wide mb-1" style="color: var(--color-text-muted)">{t(copy.nameLabel, lang)}</label>
          <input
            id="billard-name"
            type="text"
            required
            class="w-full rounded-lg px-3 py-2 text-sm"
            style="background-color: var(--color-background); border: 1px solid var(--color-border); color: var(--color-text-primary)"
          />
        </div>
        <div>
          <label for="billard-phone" class="block text-xs font-bold uppercase tracking-wide mb-1" style="color: var(--color-text-muted)">{t(copy.phoneLabel, lang)}</label>
          <input
            id="billard-phone"
            type="tel"
            required
            class="w-full rounded-lg px-3 py-2 text-sm"
            style="background-color: var(--color-background); border: 1px solid var(--color-border); color: var(--color-text-primary)"
          />
        </div>
        <p id="billard-form-error" class="text-xs hidden" style="color: #e07a5f"></p>
        <div class="flex gap-3 pt-2">
          <button type="submit" class="flex-1 rounded-full py-2.5 text-sm font-bold" style="background-color: var(--color-accent); color: var(--color-background)">
            {t(copy.confirmCta, lang)}
          </button>
          <button type="button" id="billard-modal-cancel" class="rounded-full py-2.5 px-4 text-sm font-bold" style="border: 1px solid var(--color-border); color: var(--color-text-primary)">
            {t(copy.cancelCta, lang)}
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

{isConfigured && (
  <script define:vars={{
    supabaseUrl,
    supabaseAnonKey,
    staffCancelPin,
    dateLocale,
    tableLabels: Object.fromEntries(tables.map((t2) => [t2.id, t(t2.label, lang)])),
    defaultTable: tables[0]?.id,
    slotMinutes,
    copyStrings: {
      bookedBy: t(copy.bookedBy, lang),
      past: t(copy.past, lang),
      free: t(copy.free, lang),
      loading: t(copy.loading, lang),
      todayLabel: t(copy.todayLabel, lang),
      showPast: t(copy.showPast, lang),
      hidePast: t(copy.hidePast, lang),
      successMessage: t(copy.successMessage, lang),
      takenMessage: t(copy.takenMessage, lang),
      errorMessage: t(copy.errorMessage, lang),
      nameRequired: t(copy.nameRequired, lang),
      phoneRequired: t(copy.phoneRequired, lang),
      cancelPinPrompt: t(copy.cancelPinPrompt, lang),
      cancelWrongPin: t(copy.cancelWrongPin, lang),
      cancelConfirmPrefix: t(copy.cancelConfirmPrefix, lang),
      cancelSuccess: t(copy.cancelSuccess, lang),
    },
  }}>
    document.addEventListener('astro:page-load', () => {
      const app = document.querySelector('#billard-app');
      if (!app || app.dataset.wired === 'true') return;
      app.dataset.wired = 'true';

      const statusEl = document.querySelector('#billard-status');
      const dateChipsEl = document.querySelector('#billard-date-chips');
      const tableTabs = Array.from(document.querySelectorAll('.billard-table-tab'));
      const panels = Array.from(document.querySelectorAll('.billard-table-panel'));
      const pastToggleBtn = document.querySelector('#billard-toggle-past');
      const modal = document.querySelector('#billard-modal');
      const modalSummary = document.querySelector('#billard-modal-summary');
      const form = document.querySelector('#billard-form');
      const formError = document.querySelector('#billard-form-error');
      const nameInput = document.querySelector('#billard-name');
      const phoneInput = document.querySelector('#billard-phone');
      const cancelBtn = document.querySelector('#billard-modal-cancel');

      // Local dates (not UTC) so "today" matches the visitor's own day —
      // toISOString() would drift a day around midnight in some timezones.
      function localISODate(d) {
        const y = d.getFullYear();
        const m = (d.getMonth() + 1).toString().padStart(2, '0');
        const day = d.getDate().toString().padStart(2, '0');
        return `${y}-${m}-${day}`;
      }

      const todayISO = localISODate(new Date());
      let selectedDate = todayISO;
      let selectedTable = defaultTable;
      let pastCollapsed = true;
      let pendingSlot = null; // { table, start, end }

      // Build the 7 date chips (today + 6 days) once.
      const dateOptions = [];
      for (let i = 0; i < 7; i++) {
        const d = new Date();
        d.setDate(d.getDate() + i);
        dateOptions.push(d);
      }
      dateChipsEl.innerHTML = dateOptions
        .map((d, i) => {
          const iso = localISODate(d);
          const dayLabel = i === 0 ? copyStrings.todayLabel : d.toLocaleDateString(dateLocale, { weekday: 'short' });
          const numLabel = d.getDate();
          return `<button type="button" class="billard-date-chip shrink-0 flex flex-col items-center justify-center rounded-2xl px-4 py-2 min-w-[60px] text-xs font-bold transition-colors" data-date="${iso}" style="border: 1px solid var(--color-border)">
            <span class="chip-day" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em;">${dayLabel}</span>
            <span class="chip-num" style="font-size: 15px;">${numLabel}</span>
          </button>`;
        })
        .join('');
      const dateChips = Array.from(document.querySelectorAll('.billard-date-chip'));

      function applyChipStyle(chip, active) {
        chip.style.backgroundColor = active ? 'var(--color-accent)' : 'var(--color-surface)';
        chip.style.color = active ? 'var(--color-background)' : 'var(--color-text-primary)';
        chip.style.borderColor = active ? 'var(--color-accent)' : 'var(--color-border)';
      }
      function updateActiveChip() {
        dateChips.forEach((chip) => applyChipStyle(chip, chip.dataset.date === selectedDate));
      }
      function applyTabStyle(tab, active) {
        tab.style.backgroundColor = active ? 'color-mix(in srgb, var(--color-accent) 16%, transparent)' : 'var(--color-surface)';
        tab.style.color = active ? 'var(--color-accent)' : 'var(--color-text-primary)';
        tab.style.borderColor = active ? 'var(--color-accent)' : 'var(--color-border)';
      }
      function updateActiveTab() {
        tableTabs.forEach((tab) => applyTabStyle(tab, tab.dataset.table === selectedTable));
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.table !== selectedTable;
        });
      }
      updateActiveChip();
      updateActiveTab();

      function headers() {
        return {
          apikey: supabaseAnonKey,
          Authorization: `Bearer ${supabaseAnonKey}`,
          'Content-Type': 'application/json',
        };
      }

      async function loadBookings() {
        statusEl.textContent = copyStrings.loading;
        try {
          const url = `${supabaseUrl}/rest/v1/bookings?booking_date=eq.${selectedDate}&select=table_name,start_time,end_time,customer_name`;
          const res = await fetch(url, { headers: headers() });
          if (!res.ok) throw new Error('fetch failed');
          const bookings = await res.json();
          renderGrid(bookings);
          statusEl.textContent = '';
        } catch {
          statusEl.textContent = copyStrings.errorMessage;
        }
      }

      function renderGrid(bookings) {
        const isToday = selectedDate === todayISO;
        const nowMinutes = new Date().getHours() * 60 + new Date().getMinutes();
        let pastCount = 0;

        document.querySelectorAll('.billard-slot').forEach((btn) => {
          const table = btn.dataset.table;
          const start = btn.dataset.start;
          const [h, m] = start.split(':').map(Number);
          const slotMinutesOfDay = h * 60 + m;
          const isPast = isToday && slotMinutesOfDay < nowMinutes;
          const statusSpan = btn.querySelector('.slot-status');

          const booking = bookings.find((b) => b.table_name === table && b.start_time.slice(0, 5) === start);

          btn.disabled = false;
          if (booking) {
            // Stays clickable (not disabled): clicking a booked slot is how
            // staff cancels it — see handleCancelClick below.
            statusSpan.textContent = `${copyStrings.bookedBy} — ${booking.customer_name}`;
            btn.dataset.booked = 'true';
            btn.dataset.past = 'false';
            btn.dataset.customerName = booking.customer_name;
            btn.style.backgroundColor = 'color-mix(in srgb, var(--color-text-muted) 18%, transparent)';
            btn.style.color = 'var(--color-text-muted)';
            btn.style.cursor = 'pointer';
          } else if (isPast) {
            if (table === defaultTable) pastCount++;
            statusSpan.textContent = copyStrings.past;
            btn.disabled = true;
            btn.dataset.booked = 'false';
            btn.dataset.past = 'true';
            btn.style.backgroundColor = 'transparent';
            btn.style.color = 'var(--color-text-muted)';
            btn.style.opacity = '0.5';
            btn.style.cursor = 'default';
          } else {
            statusSpan.textContent = copyStrings.free;
            btn.dataset.booked = 'false';
            btn.dataset.past = 'false';
            btn.style.backgroundColor = 'color-mix(in srgb, var(--color-accent) 14%, transparent)';
            btn.style.color = 'var(--color-accent)';
            btn.style.opacity = '1';
            btn.style.cursor = 'pointer';
          }
        });

        // "Past" only depends on the clock/date, not the table, so counting
        // it once (on defaultTable's panel) applies to every panel equally.
        if (pastCount > 0) {
          pastToggleBtn.classList.remove('hidden');
        } else {
          pastToggleBtn.classList.add('hidden');
        }
        applyPastCollapse();
      }

      function applyPastCollapse() {
        pastToggleBtn.textContent = pastCollapsed ? copyStrings.showPast : copyStrings.hidePast;
        document.querySelectorAll('.billard-slot[data-past="true"]').forEach((btn) => {
          btn.classList.toggle('hidden', pastCollapsed);
        });
      }
      pastToggleBtn.addEventListener('click', () => {
        pastCollapsed = !pastCollapsed;
        applyPastCollapse();
      });

      dateChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          selectedDate = chip.dataset.date;
          pastCollapsed = true;
          updateActiveChip();
          loadBookings();
        });
      });
      tableTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          selectedTable = tab.dataset.table;
          updateActiveTab();
        });
      });

      function openModal(table, start, end) {
        pendingSlot = { table, start, end };
        // innerHTML (not textContent) so the "start – end" part can be
        // wrapped in dir="ltr" — otherwise Arabic's bidi algorithm reorders
        // a bare "14:30 – 15:00" next to Arabic text into "15:00 – 14:30"
        // (tableLabels/table values are our own config, never user input).
        modalSummary.innerHTML = `${tableLabels[table] || table} · <span dir="ltr">${start} – ${end}</span>`;
        formError.classList.add('hidden');
        nameInput.value = '';
        phoneInput.value = '';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        nameInput.focus();
      }
      function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        pendingSlot = null;
      }

      async function handleCancelClick(btn) {
        const pin = window.prompt(copyStrings.cancelPinPrompt);
        if (pin === null) return; // staff dismissed the prompt
        if (pin !== staffCancelPin) {
          statusEl.textContent = copyStrings.cancelWrongPin;
          return;
        }
        const confirmed = window.confirm(
          `${copyStrings.cancelConfirmPrefix} ${btn.dataset.customerName} — ${btn.dataset.start} ?`
        );
        if (!confirmed) return;
        try {
          const url = `${supabaseUrl}/rest/v1/bookings?table_name=eq.${btn.dataset.table}&booking_date=eq.${selectedDate}&start_time=eq.${btn.dataset.start}`;
          const res = await fetch(url, { method: 'DELETE', headers: headers() });
          if (!res.ok) throw new Error('delete failed');
          await loadBookings();
          // loadBookings() sets its own loading/error/empty status text as
          // it goes — set the cancel confirmation AFTER it settles so it
          // isn't immediately overwritten.
          statusEl.textContent = copyStrings.cancelSuccess;
        } catch {
          statusEl.textContent = copyStrings.errorMessage;
        }
      }

      document.querySelector('#billard-slot-lists').addEventListener('click', (e) => {
        const btn = e.target.closest('.billard-slot');
        if (!btn || btn.disabled) return;
        if (btn.dataset.booked === 'true') {
          handleCancelClick(btn);
          return;
        }
        openModal(btn.dataset.table, btn.dataset.start, btn.dataset.end);
      });
      cancelBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!pendingSlot) return;
        const customerName = nameInput.value.trim();
        if (!customerName) {
          formError.textContent = copyStrings.nameRequired;
          formError.classList.remove('hidden');
          return;
        }
        const customerPhone = phoneInput.value.trim();
        if (!customerPhone) {
          formError.textContent = copyStrings.phoneRequired;
          formError.classList.remove('hidden');
          return;
        }
        const submitBtn = form.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        try {
          const res = await fetch(`${supabaseUrl}/rest/v1/bookings`, {
            method: 'POST',
            headers: { ...headers(), Prefer: 'return=minimal' },
            body: JSON.stringify({
              table_name: pendingSlot.table,
              booking_date: selectedDate,
              start_time: pendingSlot.start,
              end_time: pendingSlot.end,
              customer_name: customerName,
              customer_phone: customerPhone,
            }),
          });
          if (res.status === 409) {
            formError.textContent = copyStrings.takenMessage;
            formError.classList.remove('hidden');
            await loadBookings();
            return;
          }
          if (!res.ok) throw new Error('insert failed');
          closeModal();
          statusEl.textContent = copyStrings.successMessage;
          await loadBookings();
        } catch {
          formError.textContent = copyStrings.errorMessage;
          formError.classList.remove('hidden');
        } finally {
          submitBtn.disabled = false;
        }
      });

      loadBookings();
      setInterval(loadBookings, 20000);
    });
  </script>
)}
