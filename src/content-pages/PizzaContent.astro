---
// See HomeContent.astro's top comment for the shared-body-per-route
// pattern this and every other src/content-pages/*.astro file follows.
//
// NEW dedicated pizza page (client request, first draft — "we gaan erna
// finetunen"): Home and Menu both already have a pizza showcase section
// (see PizzaShowcaseGrid.astro), but the client wants pizza to have its
// own full page, done "op een hele mooie strakke manier", with the oven
// stamp (PizzaBadge) brought back as a feature rather than a small hero
// accent. This page is that — its own bespoke hero built around the
// stamp (no oven doors here, so PizzaBadge's `immediate` prop is used —
// see that component's own comment for why), then every real pizza on
// the menu: the 7 with the client's own photos front and center, and the
// 2 that don't have a photo yet (Four Cheese, Four Seasons) listed
// underneath rather than skipped or given a stock photo.
//
// Home's hero button and this page are now the two places pointing at
// pizza specifically — Home's "Meilleure pizza d'Agdal" button now links
// HERE instead of to the Menu page's #pizzas anchor, since this is the
// more complete destination. Home's and Menu's own inline pizza sections
// are untouched for this first draft (not asked to remove them) — worth
// asking the client whether those should now link here too instead of
// duplicating the grid, during finetuning.
//
// Round 2 ("maak er een klapper van"): three upgrades, all buildable
// without new client assets (a looping oven video and a real pizza-specific
// review quote were also on the table — deliberately skipped until real
// footage/quotes exist, see the chat for why). (1) The one pizza flagged
// `popular` in pizza-showcase.ts (Pollo) is pulled out of the grid into its
// own large editorial feature, so the page has a clear focal point instead
// of 7 equally-weighted cards. (2) Every showcase pizza now carries a short
// mood/sensory `tagline` (see pizza-showcase.ts's own comment on why these
// are never factual claims). (3) A mobile-only sticky order bar fades in
// once the hero is scrolled past — see the <script> at the bottom of this
// file and its own comment for the mechanism.
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Ornament from '../components/Ornament.astro';
import PizzaBadge from '../components/PizzaBadge.astro';
import { siteConfig } from '../config/site.config';
import { getOrderCtaLabel } from '../lib/nav';
import { pizzaShowcase } from '../content/pizza-showcase';
import { fullMenu } from '../content/full-menu';
import { t, localizedPath, arrow, type Language } from '../i18n/languages';
import { common, place } from '../i18n/ui';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name } = siteConfig.identity;
const city = t(place.city, lang);
const orderCtaLabel = getOrderCtaLabel(lang);

// The 2 pizzas that exist on the real menu but don't have a client photo
// yet (see this file's header comment) — pulled from the single source of
// truth (full-menu.ts's pizzas category) by excluding whatever pizza-
// showcase.ts already covers, so adding a photo for one of these later
// just means adding it to pizza-showcase.ts; nothing here needs editing.
const photographedNames = new Set(pizzaShowcase.map((p) => p.name.toLowerCase()));
const pizzaCategory = fullMenu.find((c) => c.slug === 'pizzas')!;
const unphotographedPizzas = pizzaCategory.items.filter(
  (item) => !photographedNames.has(item.name.replace(/\s+Pizza$/i, '').toLowerCase())
);

// The one real `popular` pizza (see pizza-showcase.ts) gets pulled out of
// the grid into its own editorial feature below the hero — everything else
// falls back to the regular grid. `find`/`filter` rather than a hardcoded
// name so this stays correct if the client's bestseller ever changes.
const featuredPizza = pizzaShowcase.find((p) => p.popular);
const gridPizzas = featuredPizza ? pizzaShowcase.filter((p) => p !== featuredPizza) : pizzaShowcase;

// "Pizza à la part" — client's own pricing rule (see chat): whole-pizza
// price ÷ 8 slices, +25% for the convenience of buying a single slice.
// Derived from `pizzaCategory.items` (full-menu.ts) rather than hardcoded
// per pizza, so this stays correct automatically if a whole-pizza price
// ever changes — exactly the same "one source of truth" reasoning as
// `unphotographedPizzas` above. Rounded to the nearest whole MAD to match
// how every other price on this site is displayed (no site price currently
// uses fractional MAD).
const slicePrice = (wholePizzaPrice: number) => Math.round((wholePizzaPrice / 8) * 1.25);

const copy = {
  metaTitle: {
    fr: `Meilleure pizza d'Agdal — ${name} | ${city}`,
    en: `Best pizza in Agdal — ${name} | ${city}`,
    ar: `أفضل بيتزا في أكدال — ${name} | ${city}`,
  },
  metaDescription: {
    fr: `Découvrez toutes les pizzas de ${name} à Agdal, ${city} : pâte fine, ingrédients frais, cuisson soignée. La pizza la plus commandée du quartier.`,
    en: `Discover every pizza at ${name} in Agdal, ${city}: thin crust, fresh ingredients, careful baking. The most-ordered pizza in the neighborhood.`,
    ar: `اكتشف جميع أنواع البيتزا في ${name} بأكدال، ${city}: عجينة رفيعة، مكونات طازجة، طهي متقن. البيتزا الأكثر طلبًا في الحي.`,
  },
  kicker: { fr: 'Notre spécialité', en: 'Our specialty', ar: 'تخصصنا' },
  heroTitle: { fr: "La meilleure pizza d'Agdal", en: 'The best pizza in Agdal', ar: 'أفضل بيتزا في أكدال' },
  heroSubtitle: {
    fr: 'Pâte fine, ingrédients frais, cuisson soignée au four — découvrez toutes nos pizzas, une par une.',
    en: 'Thin crust, fresh ingredients, carefully oven-baked — discover every one of our pizzas.',
    ar: 'عجينة رفيعة، مكونات طازجة، طهي متقن بالفرن — اكتشف كل أنواع البيتزا لدينا واحدة تلو الأخرى.',
  },
  alsoOnMenuKicker: { fr: 'Aussi sur la carte', en: 'Also on the menu', ar: 'أيضًا في القائمة' },
  alsoOnMenuTitle: { fr: 'Deux autres façons de se régaler', en: 'Two more ways to enjoy', ar: 'طريقتان أخريان للاستمتاع' },
  alsoOnMenuIntro: {
    fr: "Pas encore en photo sur cette page, mais bien réelles sur la carte de Dom's Café.",
    en: "Not photographed on this page yet, but very real on Dom's Café's menu.",
    ar: 'لم تُصوَّر بعد في هذه الصفحة، لكنها حاضرة فعليًا في قائمة Dom\'s Café.',
  },
  readyToOrder: { fr: 'Prêt à commander ?', en: 'Ready to order?', ar: 'جاهز للطلب؟' },
  featuredKicker: { fr: 'Le coup de cœur', en: 'The favorite', ar: 'المفضلة' },
  featuredCta: { fr: 'Commander cette pizza', en: 'Order this pizza', ar: 'اطلب هذه البيتزا' },
  sliceBadge: { fr: 'Une première à Rabat', en: 'A first in Rabat', ar: 'الأولى من نوعها في الرباط' },
  sliceTitle: { fr: 'La pizza à la part', en: 'Pizza by the slice', ar: 'البيتزا بالقطعة' },
  sliceIntro: {
    fr: "Chez nous, pas besoin de commander une pizza entière pour se faire plaisir. Chaque pizza de notre carte est aussi disponible à la part — une idée encore rare à Rabat, et que nous sommes fiers d'être les premiers à proposer.",
    en: "You don't need to order a whole pizza to enjoy one here. Every pizza on our menu is also available by the slice — still a rare idea in Rabat, and one we're proud to be the first to offer.",
    ar: 'ليس من الضروري طلب بيتزا كاملة للاستمتاع بها عندنا. كل بيتزا في قائمتنا متوفرة أيضًا بالقطعة، وهي فكرة لا تزال نادرة في الرباط، ونحن فخورون بأننا أول من يقدمها.',
  },
  sliceStep1: { fr: 'On la découpe', en: 'We cut it', ar: 'نقطعها' },
  sliceStep1Desc: {
    fr: 'Chaque pizza sort du four entière, puis est découpée devant vous en 8 parts égales.',
    en: 'Every pizza comes out of the oven whole, then is cut into 8 equal slices right in front of you.',
    ar: 'تخرج كل بيتزا من الفرن كاملة، ثم تُقطّع أمامكم إلى 8 قطع متساوية.',
  },
  sliceStep2: { fr: 'Vous choisissez', en: 'You choose', ar: 'تختارون' },
  sliceStep2Desc: {
    fr: "Une part, deux parts, ou plusieurs pizzas différentes à la part — à vous de composer.",
    en: 'One slice, two slices, or several different pizzas by the slice — you decide the mix.',
    ar: 'قطعة واحدة أو قطعتان أو عدة أنواع مختلفة بالقطعة، الاختيار لكم.',
  },
  sliceStep3: { fr: 'Vous dégustez', en: 'You enjoy', ar: 'تستمتعون' },
  sliceStep3Desc: {
    fr: 'Sur place ou à emporter, chaude et prête en quelques minutes.',
    en: 'Eat in or take away, hot and ready in minutes.',
    ar: 'في المكان أو للطلب الخارجي، ساخنة وجاهزة في دقائق.',
  },
  sliceMenuTitle: { fr: 'Le prix, part par part', en: 'The price, slice by slice', ar: 'السعر، قطعة بقطعة' },
  sliceMenuIntro: {
    fr: "Chaque part correspond à 1/8 de la pizza entière.",
    en: 'Each slice is 1/8th of the whole pizza.',
    ar: 'كل قطعة تعادل ثُمن البيتزا الكاملة.',
  },
  slicePerSlice: { fr: 'la part', en: 'per slice', ar: 'للقطعة' },
  orPerSlice: { fr: 'ou la part', en: 'or per slice', ar: 'أو بالقطعة' },
  cheesePullCaption: {
    fr: 'Le moment que tout le monde photographie.',
    en: 'The moment everyone photographs.',
    ar: 'اللحظة التي يصورها الجميع.',
  },
  sliceCta: { fr: 'Commander à la part', en: 'Order by the slice', ar: 'اطلب بالقطعة' },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

const pizzaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Pizza — ${name}`,
  hasMenuSection: [
    {
      '@type': 'MenuSection',
      name: t(pizzaCategory.label, lang),
      hasMenuItem: pizzaCategory.items.map((item) => ({
        '@type': 'MenuItem',
        name: item.name,
        description: t(item.description, lang),
        offers: { '@type': 'Offer', price: item.priceMAD, priceCurrency: 'MAD' },
      })),
    },
  ],
};

const path = localizedPath('/pizza', lang);
---
<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
  jsonLd={pizzaJsonLd}
>
  <!-- Bespoke hero — atmospheric rooftop-at-sunset photo behind the stamp
       (client's own asset, see chat). Two separate images rather than one
       CSS background — the client supplied a true portrait crop for
       mobile (the landscape version was cropping badly on phones) —
       following the exact same <img>/<img> sm:hidden / hidden sm:block
       pattern HomeContent.astro's own hero already uses for the same
       reason. Same reasoning on the oven-door reveal: client asked for
       "hetzelfde effect als op de hoofdpagina" — this is a straight port
       of Home's #home-hero door mechanism (see this file's <style> block
       at the bottom, and Home's own much longer comment on the door
       markup for the full reasoning) onto this hero, just re-scoped to
       #pizza-hero so Astro's per-component CSS scoping keeps the two
       independent. Because the door now provides its own reveal beat,
       PizzaBadge no longer uses `immediate` here — its default ~2.1s
       delay is what's tuned to match this exact door timing on Home, so
       dropping the prop is what makes the two "read as one continuous
       beat" the same way Home's does. -->
  <section id="pizza-hero" class="relative overflow-hidden py-20 sm:py-28 flex flex-col items-center text-center px-5">
    <img src="/images/dom/pizzas/hero-rooftop-mobile.webp" alt="" aria-hidden="true" class="sm:hidden absolute inset-0 w-full h-full object-cover" />
    <img src="/images/dom/pizzas/hero-rooftop.webp" alt="" aria-hidden="true" class="hidden sm:block absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(10, 6, 3, 0.55) 0%, rgba(10, 6, 3, 0.7) 55%, var(--color-background) 100%)"></div>

    <!-- Same top-hinged brushed-steel oven door as Home's hero — see this
         file's header comment above for why it's duplicated rather than
         shared, and the <style> block below for the actual CSS (a literal
         port of Home's, just re-scoped). -->
    <div class="oven-doors-big" aria-hidden="true">
      <div class="oven-glow-big"></div>
      <div class="oven-door-steel">
        <div class="oven-door-steel-hinge-shadow"></div>
        <div class="oven-door-handle">
          <span class="oven-door-handle-bracket"></span>
          <span class="oven-door-handle-bar"></span>
          <span class="oven-door-handle-bracket"></span>
        </div>
      </div>
    </div>

    <span class="relative z-10 block text-[10px] font-bold uppercase tracking-[0.3em] mb-2" style="color: var(--color-accent)">{t(copy.kicker, lang)} · Agdal, {city}</span>

    <div class="relative z-10 w-56 h-56 sm:w-72 sm:h-72 my-6" data-reveal="scale">
      <PizzaBadge lang={lang} href={`${localizedPath('/pizza', lang)}#pizzas`} class="absolute inset-0" />
    </div>

    <h1 class="relative z-10 font-display text-4xl sm:text-6xl font-semibold max-w-3xl" style="color: var(--color-text-primary); text-shadow: 0 2px 16px rgba(0, 0, 0, 0.6)">
      {t(copy.heroTitle, lang)}
    </h1>
    <p class="relative z-10 mt-4 max-w-xl text-sm sm:text-base" style="color: var(--color-text-primary); text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6)">
      {t(copy.heroSubtitle, lang)}
    </p>

    <div class="relative z-10 mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href={orderCtaLabel.href} external variant="filled">{orderCtaLabel.label}</Button>
      <Button href={localizedPath('/menu', lang)} variant="outline">{t(common.voirLeMenuComplet, lang)}</Button>
    </div>
  </section>

  <!-- Marks where the hero ends, for the sticky mobile order bar's
       IntersectionObserver below — the bar appears once this leaves the
       viewport, i.e. once someone has scrolled past the hero. -->
  <div id="hero-end-marker"></div>

  <!-- "Pizza à la part" — the client's own concept, and the actual reason
       this page exists in its current form: Dom's Café wants to be the
       first in Rabat to sell every pizza by the slice, not just whole, and
       asked for this to be explained visually, with "top kwaliteit"
       photography, right up front — hence its placement as the very next
       thing after the hero, before even the bestseller feature. Real
       client photos of an actual cut-and-lift sequence (see the three
       slice-*.webp files' own history: one of the three source images had
       another business's name burned into the cutting board and was
       cropped to remove it before use here — never publish a competitor's
       branding on this site by accident). Slice pricing is computed, not
       typed in — see the `slicePrice` helper above — from the same
       `pizzaCategory.items` used everywhere else on this page, so a future
       price change to any whole pizza updates its slice price here too. -->
  <section class="section-tint-warm">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-16 sm:py-24">
      <div class="max-w-2xl mx-auto text-center mb-12" data-reveal>
        <span
          class="inline-flex items-center gap-1.5 mb-5 px-3 py-1.5 rounded-full text-xs font-bold"
          style="border: 1px solid var(--color-border); color: var(--color-accent); background-color: color-mix(in srgb, var(--color-accent) 12%, transparent)"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="shrink-0">
            <path d="M12 2l2.6 6.9 7.4.3-5.8 4.6 2.1 7.2-6.3-4.2-6.3 4.2 2.1-7.2-5.8-4.6 7.4-.3z" />
          </svg>
          {t(copy.sliceBadge, lang)}
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold" style="color: var(--color-text-primary)">
          {t(copy.sliceTitle, lang)}
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)">
          {t(copy.sliceIntro, lang)}
        </p>
      </div>

      <!-- The 3-shot sequence — cut, lift, plate — is the actual "wow" the
           client asked for: it shows the slice being made, not just a
           finished slice sitting on a plate, so the concept reads
           immediately even to someone who's never seen pizza sold this way
           before. -->
      <div class="grid sm:grid-cols-3 gap-6 sm:gap-5 mb-14">
        {[
          { src: '/images/dom/pizzas/slice-cut.webp', step: copy.sliceStep1, desc: copy.sliceStep1Desc },
          { src: '/images/dom/pizzas/slice-lift.webp', step: copy.sliceStep2, desc: copy.sliceStep2Desc },
          { src: '/images/dom/pizzas/slice-plated.webp', step: copy.sliceStep3, desc: copy.sliceStep3Desc },
        ].map((frame, i) => (
          <div data-reveal style={`transition-delay: ${i * 100}ms`}>
            <div class="relative rounded-2xl overflow-hidden aspect-[4/3]" style="border: 1px solid var(--color-border)">
              <img src={frame.src} alt="" aria-hidden="true" class="w-full h-full object-cover" loading="lazy" />
              <span
                class="absolute top-3 flex items-center justify-center w-8 h-8 rounded-full text-sm font-bold rtl:right-3 ltr:left-3"
                style="background-color: var(--color-accent); color: var(--color-background)"
              >
                {i + 1}
              </span>
            </div>
            <h3 class="mt-4 font-display font-semibold text-lg" style="color: var(--color-text-primary)">{t(frame.step, lang)}</h3>
            <p class="mt-1 text-sm leading-relaxed" style="color: var(--color-text-muted)">{t(frame.desc, lang)}</p>
          </div>
        ))}
      </div>

      <!-- Price-per-slice list — every real pizza on the menu, one line
           each, whole price shown alongside so the value is transparent
           rather than the slice price appearing out of nowhere. -->
      <div class="max-w-3xl mx-auto rounded-2xl p-6 sm:p-8" style="background-color: var(--color-surface); border: 1px solid var(--color-border)" data-reveal>
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
          <h3 class="font-display text-xl font-semibold" style="color: var(--color-text-primary)">{t(copy.sliceMenuTitle, lang)}</h3>
        </div>
        <p class="text-xs mb-5" style="color: var(--color-text-muted)">{t(copy.sliceMenuIntro, lang)}</p>
        <div class="grid sm:grid-cols-2 gap-x-8 gap-y-3">
          {pizzaCategory.items.map((item) => (
            <div class="flex items-center justify-between gap-3 py-2" style="border-bottom: 1px solid var(--color-border)">
              <span class="text-sm font-semibold" style="color: var(--color-text-primary)">{item.name}</span>
              <span class="text-sm font-bold shrink-0" style="color: var(--color-accent)">
                {slicePrice(item.priceMAD)} MAD <span class="font-normal" style="color: var(--color-text-muted)">/ {t(copy.slicePerSlice, lang)}</span>
              </span>
            </div>
          ))}
        </div>
        <div class="mt-7 text-center">
          <Button href={orderCtaLabel.href} external variant="filled">{t(copy.sliceCta, lang)}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Full-bleed cheese-pull break — option 1 of the "iets spectaculairs"
       ask (see chat): no new photography, no new interaction code, just
       the existing lift shot blown up to the full width of the page and
       given room to actually breathe, with one short line over it instead
       of another content block. This is deliberately the simplest of the
       three options discussed (a scroll-triggered "pizza splits into 8
       slices" animation was floated as a likely round 2 — see the header
       comment at the top of this file when that's built) — proof that
       "spectacular" doesn't have to mean "complicated", just confident
       enough to let one real photo fill the whole screen. object-position
       is tuned (not plain `center`) so the actual cheese pull — the part
       of the photo doing the work — stays in frame at every viewport
       width instead of being cropped by object-cover. -->
  <section class="relative overflow-hidden h-[60vh] sm:h-[80vh]">
    <img
      src="/images/dom/pizzas/slice-lift.webp"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover"
      style="object-position: 50% 35%"
      loading="lazy"
    />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(10,6,3,0) 40%, rgba(10,6,3,0.85) 100%)"></div>
    <p
      class="absolute inset-x-0 bottom-8 sm:bottom-12 text-center font-display text-xl sm:text-3xl font-semibold px-5"
      style="color: var(--color-text-primary); text-shadow: 0 2px 16px rgba(0,0,0,0.7)"
    >
      {t(copy.cheesePullCaption, lang)}
    </p>
  </section>

  <!-- Editorial feature for the one real bestseller (see the
       `featuredPizza` comment above) — deliberately NOT another grid card:
       full-bleed-ish photo on one side, story + CTA on the other, so the
       page has one clear "look at THIS one" moment before settling into
       the calmer grid of everything else. -->
  {featuredPizza && (
    <section class="max-w-6xl mx-auto px-5 sm:px-8 pt-4 pb-16 sm:pb-20">
      <div class="grid lg:grid-cols-2 gap-0 rounded-2xl overflow-hidden" style="background-color: var(--color-surface); border: 1px solid var(--color-border)" data-reveal>
        <div class="photo-frame aspect-[4/3] lg:aspect-auto">
          <img
            src={featuredPizza.image}
            alt={t(featuredPizza.imageAlt, lang)}
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
        <div class="p-8 sm:p-10 flex flex-col justify-center">
          <span class="block text-[10px] font-bold uppercase tracking-[0.3em] mb-3" style="color: var(--color-accent)">{t(copy.featuredKicker, lang)}</span>
          <h2 class="font-display text-3xl sm:text-4xl font-semibold" style="color: var(--color-text-primary)">{featuredPizza.name}</h2>
          {featuredPizza.tagline && (
            <p class="mt-2 text-base italic" style="color: var(--color-accent)">{t(featuredPizza.tagline, lang)}</p>
          )}
          <p class="mt-4 text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)">{t(featuredPizza.description, lang)}</p>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-bold text-2xl" style="color: var(--color-accent)">{featuredPizza.priceMAD} MAD</span>
            <span class="text-xs" style="color: var(--color-text-muted)">{t(copy.orPerSlice, lang)} {slicePrice(featuredPizza.priceMAD)} MAD</span>
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <Button href={orderCtaLabel.href} external variant="filled">{t(copy.featuredCta, lang)}</Button>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- The remaining photographed pizzas — bigger, more spacious cards than
       the compact homepage/menu teaser (PizzaShowcaseGrid.astro): 3 per row
       instead of 4, a taller photo, and the description gets more room
       to breathe, since this page's whole reason to exist is giving
       pizza the spotlight the client asked for. -->
  <section id="pizzas" class="max-w-6xl mx-auto px-5 sm:px-8 py-16 sm:py-20">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {gridPizzas.map((pizza, i) => (
        <div
          class="card-lift relative rounded-2xl overflow-hidden"
          style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${i * 70}ms`}
          data-reveal
        >
          <div class="photo-frame aspect-[4/3]">
            <img src={pizza.image} alt={t(pizza.imageAlt, lang)} class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="menu-item-name font-display font-semibold text-xl" style="color: var(--color-text-primary)">{pizza.name}</h3>
              <span class="shrink-0 text-right">
                <span class="menu-item-price block font-bold text-lg" style="color: var(--color-accent)">{pizza.priceMAD} MAD</span>
                <span class="block text-[11px]" style="color: var(--color-text-muted)">{t(copy.orPerSlice, lang)} {slicePrice(pizza.priceMAD)} MAD</span>
              </span>
            </div>
            {pizza.tagline && (
              <p class="text-xs mt-1 italic" style="color: var(--color-accent)">{t(pizza.tagline, lang)}</p>
            )}
            <p class="text-sm mt-2 leading-relaxed" style="color: var(--color-text-muted)">{t(pizza.description, lang)}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- The 2 pizzas without a photo yet — real, honest, no invented or
       stock imagery (see this file's header comment and pizza-
       showcase.ts's own comment on the same principle). Simple text
       cards, clearly a step down in visual weight from the photographed
       ones above so nothing here reads as a missing/broken photo. -->
  {unphotographedPizzas.length > 0 && (
    <div class="section-tint-warm">
      <section class="max-w-4xl mx-auto px-5 sm:px-8 py-16 sm:py-20">
        <div class="max-w-xl mb-8" data-reveal>
          <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-2" style="color: var(--color-accent)">{t(copy.alsoOnMenuKicker, lang)}</span>
          <h2 class="font-display text-2xl sm:text-3xl font-semibold" style="color: var(--color-text-primary)">{t(copy.alsoOnMenuTitle, lang)}</h2>
          <p class="mt-2 text-sm" style="color: var(--color-text-muted)">{t(copy.alsoOnMenuIntro, lang)}</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {unphotographedPizzas.map((item, j) => (
            <div
              class="card-lift flex items-start justify-between gap-4 rounded-xl p-4"
              style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${j * 70}ms`}
              data-reveal
            >
              <div class="min-w-0">
                <h3 class="menu-item-name font-display font-semibold" style="color: var(--color-text-primary)">{item.name}</h3>
                <p class="text-sm mt-1" style="color: var(--color-text-muted)">{t(item.description, lang)}</p>
              </div>
              <span class="shrink-0 text-right">
                <span class="menu-item-price block font-bold" style="color: var(--color-accent)">{item.priceMAD} MAD</span>
                <span class="block text-[11px]" style="color: var(--color-text-muted)">{t(copy.orPerSlice, lang)} {slicePrice(item.priceMAD)} MAD</span>
              </span>
            </div>
          ))}
        </div>
      </section>
    </div>
  )}

  <Ornament />
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 text-center">
    <p class="text-sm mb-4" style="color: var(--color-text-muted)">{t(copy.readyToOrder, lang)}</p>
    <Button href={orderCtaLabel.href} external variant="filled">{orderCtaLabel.label} {arrow(lang)}</Button>
  </section>

  <!-- Mobile-only sticky order bar (see the <script> below for the
       show/hide mechanism) — desktop already has "Commander" in the header,
       but on mobile that's easy to lose track of on a page this long, and
       this page's whole point is to convert pizza browsing into an order. -->
  <div id="pizza-sticky-bar" class="pizza-sticky-bar sm:hidden" aria-hidden="true">
    <a href={orderCtaLabel.href} target="_blank" rel="noreferrer" class="pizza-sticky-bar-link">
      {orderCtaLabel.label}
    </a>
  </div>
</Layout>

<style>
  .pizza-sticky-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.35);
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }
  .pizza-sticky-bar.is-visible {
    transform: translateY(0);
  }
  .pizza-sticky-bar-link {
    display: block;
    text-align: center;
    padding: 0.85rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    background-color: var(--color-accent);
    color: var(--color-background);
  }

  /* ============================================================================
     Oven-door hero reveal — a straight port of HomeContent.astro's own
     #home-hero door mechanism (see the header comment above the markup for
     why it's duplicated rather than shared as a component: it's tightly
     coupled to this hero's own perspective/id, and Astro scopes each
     component's <style> block separately anyway, so copy-and-rescope is
     the honest option here, not a hack). Every rule below is identical to
     Home's except the selector (#home-hero → #pizza-hero) — see that
     file's own much longer comment block for the full design reasoning
     (brushed-steel panel construction, why rotateX not rotateY, the
     client's real-photo-driven feedback that led here, etc). */
  #pizza-hero {
    perspective: 2200px;
  }
  .oven-doors-big {
    position: absolute;
    inset: 0;
    z-index: 50;
    pointer-events: none;
  }
  .oven-glow-big {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(255, 170, 80, 0.95) 0%, rgba(200, 100, 30, 0.5) 42%, transparent 72%);
    opacity: 0;
    animation: hero-glow-flash 1s ease-out 0.15s both;
  }
  .oven-door-steel {
    position: absolute;
    inset: 0;
    transform-origin: top center;
    background:
      linear-gradient(
        100deg,
        rgba(255, 255, 255, 0.4) 0%,
        transparent 14%,
        transparent 38%,
        rgba(255, 255, 255, 0.3) 47%,
        transparent 56%,
        transparent 80%,
        rgba(255, 255, 255, 0.22) 92%,
        transparent 100%
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.07) 0px,
        rgba(255, 255, 255, 0.07) 1px,
        transparent 1px,
        transparent 3px
      ),
      linear-gradient(160deg, #e9ebed 0%, #c4c7cc 28%, #f0f1f2 45%, #a7abb1 64%, #d8dadd 100%);
    box-shadow: inset 0 0 70px rgba(0, 0, 0, 0.28);
    backface-visibility: hidden;
    animation: hero-door-open 1.7s cubic-bezier(0.7, 0, 0.3, 1) 0.35s both;
  }
  .oven-door-steel-hinge-shadow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35), transparent);
  }
  .oven-door-handle {
    position: absolute;
    left: 50%;
    top: 60%;
    transform: translate(-50%, -50%);
    width: 34%;
    min-width: 160px;
    height: 6%;
    min-height: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2%;
  }
  .oven-door-handle-bracket {
    width: 8%;
    min-width: 14px;
    height: 150%;
    background: linear-gradient(180deg, #9a9da3, #6c6f74);
    border-radius: 3px;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.35);
  }
  .oven-door-handle-bar {
    flex: 1;
    height: 100%;
    background: linear-gradient(180deg, #3a3a3c 0%, #1c1c1e 45%, #050505 100%);
    border-radius: 9999px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.55), inset 0 1px 1px rgba(255, 255, 255, 0.3);
  }

  @keyframes hero-door-open {
    0% { transform: rotateX(0deg); }
    100% { transform: rotateX(-112deg); }
  }
  @keyframes hero-glow-flash {
    0% { opacity: 0; }
    40% { opacity: 1; }
    70% { opacity: 0.35; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .oven-glow-big {
      display: none;
    }
    .oven-door-steel {
      animation: none;
      transform: rotateX(-112deg);
      opacity: 0;
    }
  }
</style>

<script>
  // Fades the mobile order bar in once the hero (marked by #hero-end-marker
  // just below the hero section) has scrolled out of view, and back out if
  // someone scrolls back up to the top — an IntersectionObserver instead of
  // a scroll listener so this stays cheap on low-end phones. Wrapped in
  // 'astro:page-load' to match this codebase's convention for re-init on
  // View Transitions navigation (see MenuContent.astro's own script).
  document.addEventListener('astro:page-load', () => {
    const bar = document.querySelector<HTMLElement>('#pizza-sticky-bar');
    const marker = document.querySelector<HTMLElement>('#hero-end-marker');
    if (!bar || !marker) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        const pastHero = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        bar.classList.toggle('is-visible', pastHero);
        bar.setAttribute('aria-hidden', pastHero ? 'false' : 'true');
      },
      { threshold: 0 }
    );
    observer.observe(marker);
  });
</script>
