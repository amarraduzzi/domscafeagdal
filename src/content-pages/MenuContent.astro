---
// See HomeContent.astro's top comment for the shared-body-per-route
// pattern this and every other src/content-pages/*.astro file follows.
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Ornament from '../components/Ornament.astro';
import PizzaShowcaseGrid from '../components/PizzaShowcaseGrid.astro';
import { siteConfig } from '../config/site.config';
import { getOrderCtaLabel } from '../lib/nav';
import { fullMenu } from '../content/full-menu';
import { t, localizedPath, type Language } from '../i18n/languages';
import { common, place } from '../i18n/ui';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name } = siteConfig.identity;
const primaryKeyword = t(siteConfig.identity.primaryKeyword, lang);
const city = t(place.city, lang);
const orderCtaLabel = getOrderCtaLabel(lang);

const copy = {
  // Keyword-first, same reasoning as HomeContent.astro's metaTitle.
  metaTitle: {
    fr: `${primaryKeyword} à ${city} — Menu | ${name}`,
    en: `${primaryKeyword} in ${city} — Menu | ${name}`,
    ar: `${primaryKeyword} في ${city} — القائمة | ${name}`,
  },
  metaDescription: {
    fr: `Découvrez le menu de ${name}, ${primaryKeyword} à ${city} : boissons, petits-déjeuners, crêpes, pizzas, sandwiches, pâtes et desserts. Commandez en ligne ou sur place.`,
    en: `Discover the menu of ${name}, ${primaryKeyword} in ${city}: drinks, breakfasts, crêpes, pizzas, sandwiches, pasta and desserts. Order online or dine in.`,
    ar: `اكتشف قائمة ${name}, ${primaryKeyword} في ${city}: مشروبات، فطور، كريب، بيتزا، سندويشات، معكرونة وحلويات. اطلب أونلاين أو تناول الطعام في المقهى.`,
  },
  heroAlt: {
    fr: `Plats du menu de ${name}`,
    en: `Dishes from ${name}'s menu`,
    ar: `أطباق من قائمة ${name}`,
  },
  // Added the city here too — was missing, so this H1 wasn't matching the
  // local "restaurant indien Rabat" intent as closely as it could.
  heroTitle: {
    fr: `Le menu de notre ${primaryKeyword} à ${city}`,
    en: `The menu at our ${primaryKeyword} in ${city}`,
    ar: `قائمة ${primaryKeyword} الخاص بنا في ${city}`,
  },
  heroSubtitle: {
    fr: 'Une sélection de nos plats signature. Le menu complet, avec toutes les options et suppléments, est disponible au moment de la commande.',
    en: 'A selection of our signature dishes. The full menu, with all options and extras, is available at the time of ordering.',
    ar: 'تشكيلة من أطباقنا المميزة. القائمة الكاملة، بجميع الخيارات والإضافات، متوفرة عند الطلب.',
  },
  readyToOrder: { fr: 'Prêt à commander ?', en: 'Ready to order?', ar: 'جاهز للطلب؟' },
  // "Best pizza" section — same copy as Home's own pizza section (see
  // HomeContent.astro), repeated here since this is the OTHER end of the
  // hero's new "Beste pizza van Agdal" deep link (#pizzas below).
  pizzaKicker: { fr: 'Notre spécialité', en: 'Our specialty', ar: 'تخصصنا' },
  pizzaTitle: { fr: 'La meilleure pizza de Rabat', en: 'The best pizza in Rabat', ar: 'أفضل بيتزا في الرباط' },
  pizzaIntro: {
    fr: 'Pâte fine, ingrédients frais, cuisson soignée — voici les pizzas les plus commandées à Agdal.',
    en: 'Thin crust, fresh ingredients, careful baking — the most-ordered pizzas in Agdal.',
    ar: 'عجينة رفيعة، مكونات طازجة، طهي متقن — أكثر أنواع البيتزا طلبًا في أكدال.',
  },
  pizzaPopularBadge: { fr: 'Populaire', en: 'Popular', ar: 'الأكثر طلبًا' },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

const menuJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Menu — ${name}`,
  hasMenuSection: fullMenu.map((cat) => ({
    '@type': 'MenuSection',
    name: t(cat.label, lang),
    hasMenuItem: cat.items.map((item) => ({
      '@type': 'MenuItem',
      name: item.name,
      description: t(item.description, lang),
      offers: { '@type': 'Offer', price: item.priceMAD, priceCurrency: 'MAD' },
    })),
  })),
};

const path = localizedPath('/menu', lang);
---
<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
  jsonLd={menuJsonLd}
>
  <!-- Menu's own bolder opening moment — every interior page used the same
       compact PageHero, which made the whole site feel like one page
       repeated. Menu gets the exception: taller, with the same Ken Burns
       drift as the Home spotlight, since this is the page people actually
       linger on. Home stays the one full-height "big" hero — this is a
       step up from PageHero, not a rival to Home. -->
  <section class="relative min-h-[420px] sm:h-[64vh] flex items-end overflow-hidden" data-reveal="scale">
    <div class="ken-burns absolute inset-0">
      <img
        src="https://i.ibb.co/nMT3yQLh/Chat-GPT-Image-21-jul-2026-00-13-56.webp"
        alt={t(copy.heroAlt, lang)}
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>
    <div class="absolute inset-0" style="background: linear-gradient(0deg, var(--color-background) 12%, rgba(11,11,12,0.4) 55%, rgba(11,11,12,0.6) 100%)"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 pb-12 sm:pb-16 w-full">
      <span class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-3" style="color: var(--color-accent)">{city}</span>
      <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl font-semibold" style="color: var(--color-text-primary)">
        {t(copy.heroTitle, lang)}
      </h1>
      <p class="mt-4 max-w-xl text-sm sm:text-base" style="color: var(--color-text-muted)">
        {t(copy.heroSubtitle, lang)}
      </p>
      <!-- Homemade badge — this is the page people are actually deciding
           what to order on, so it sits right under the subtitle where that
           decision happens, not buried in a paragraph further down. -->
      <span
        class="inline-flex items-center gap-1.5 mt-4 px-3 py-1.5 rounded-full text-xs font-bold"
        style="border: 1px solid var(--color-border); color: var(--color-accent); background-color: color-mix(in srgb, var(--color-accent) 12%, transparent)"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
          <path d="M5 12.5l4.5 4.5L19 7" />
        </svg>
        {t(common.homemadeBadge, lang)}
      </span>
    </div>
  </section>

  <!-- Sticky order bar — this used to be a plain one-off button right
       under the hero, easy to miss once you'd scrolled two categories
       down into an appetite you can't act on without scrolling back up.
       `position: sticky` (no JS, consistent with WhatsAppButton's own
       "no unnecessary client-side dependency" stance) keeps the order CTA
       one tap away for the entire scroll, pinned under the sticky header
       instead of competing with the WhatsApp FAB for the bottom corner. -->
  <div
    class="sticky top-16 sm:top-20 z-30"
    style="background-color: color-mix(in srgb, var(--color-surface) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--color-border)"
  >
    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-3 flex items-center justify-between gap-4">
      <p class="hidden sm:block text-sm font-semibold" style="color: var(--color-text-primary)">{t(copy.readyToOrder, lang)}</p>
      <Button href={orderCtaLabel.href} external variant="cta" class="!py-2.5 !px-5 text-xs sm:text-sm">{orderCtaLabel.label}</Button>
    </div>
  </div>

  <!-- "Best pizza in Agdal" — the other end of the Home hero's new "Beste
       pizza van Agdal" button (#pizzas). Same shared component as Home
       (see PizzaShowcaseGrid.astro) so this is exactly as prominent here
       as it is on Home, right at the top of the page, ahead of the rest
       of the menu — the client's own instruction ("de site moet de pizza
       veel aanprijzen"). showMenuCta is off here since "voir le menu
       complet" makes no sense as a link to the page you're already on. -->
  <PizzaShowcaseGrid
    lang={lang}
    id="pizzas"
    kicker={t(copy.pizzaKicker, lang)}
    title={t(copy.pizzaTitle, lang)}
    intro={t(copy.pizzaIntro, lang)}
    popularBadge={t(copy.pizzaPopularBadge, lang)}
    orderCtaHref={orderCtaLabel.href}
    orderCtaLabel={orderCtaLabel.label}
    showMenuCta={false}
  />

  <!-- Typographic moment — same oversized-number language as À propos,
       repeated here instead of only appearing on one page of the site. -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 pt-10 sm:pt-14 pb-10 sm:pb-14 flex flex-col sm:flex-row sm:items-end gap-4 sm:gap-10" data-reveal>
    <p class="stat-huge">100%</p>
    <p class="max-w-sm text-sm sm:text-base sm:pb-1" style="color: var(--color-text-muted)">
      {t(common.preparesCommandeLine, lang)}
    </p>
  </section>

  <!-- Search + category filter — the client asked for a search option "in
       the style" of Dom's own live ordering site's category-pill row
       (screenshot supplied). Genuinely functional here, unlike that
       reference: on the live site those pills turn out to be decorative
       quick-jump anchors, not real filters (checked via that page's own
       JS) — this version actually hides everything that doesn't match.
       Category pill (exclusive) + Végétarien toggle + free-text search all
       combine (AND), all client-side, no reload — same "no unnecessary
       JS dependency" stance as the rest of this codebase. -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 pb-6" data-reveal>
    <div class="relative mb-4 max-w-md">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute top-1/2 -translate-y-1/2 rtl:right-3.5 ltr:left-3.5" style="color: var(--color-text-muted)">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        id="menu-search"
        type="search"
        placeholder={t(common.rechercherDansLeMenu, lang)}
        class="w-full rounded-full text-sm py-2.5 rtl:pr-10 rtl:pl-4 ltr:pl-10 ltr:pr-4"
        style="background-color: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text-primary)"
      />
    </div>
    <div class="flex flex-wrap items-center gap-2 overflow-x-auto pb-1">
      <button type="button" class="menu-filter-btn is-active" data-cat-filter="all">{t(common.toutLeMenu, lang)}</button>
      {fullMenu.map((category) => (
        <button type="button" class="menu-filter-btn" data-cat-filter={category.slug}>
          {category.emoji} {t(category.label, lang)}
        </button>
      ))}
      <span class="w-px h-5 mx-1 shrink-0" style="background-color: var(--color-border)" />
      <button type="button" class="menu-filter-btn" data-veg-toggle>🌱 {t(common.vegetarienUniquement, lang)}</button>
    </div>
  </section>

  <!-- Alternating band now goes warm (--color-primary-dark) instead of
       plain grey — the deep wine tone from the order-engine, applied
       here rather than À propos/Avis because it's food, and warmth fits
       a menu the way it doesn't fit an editorial about-page. -->
  {fullMenu.map((category, i) => (
    <div class={i % 2 === 1 ? 'section-tint-warm' : ''} data-menu-category data-category={category.slug}>
      <section class="max-w-7xl mx-auto px-5 sm:px-8 py-8 sm:py-10">
        <h2
          class="font-display text-2xl font-semibold mb-5 pb-3 flex items-baseline gap-3"
          style="color: var(--color-text-primary); border-bottom: 1px solid var(--color-border)"
        >
          <span class="text-xl" aria-hidden="true">{category.emoji}</span>
          {t(category.label, lang)}
        </h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {category.items.map((item, j) => (
            <div
              class="card-lift flex items-start gap-4 rounded-xl p-4"
              style={`background-color: ${i % 2 === 1 ? 'color-mix(in srgb, var(--color-primary-dark) 14%, var(--color-surface-muted))' : 'var(--color-surface)'}; border: 1px solid var(--color-border); transition-delay: ${j * 70}ms`}
              data-reveal
              data-menu-item
              data-veg={item.vegetarian ? 'true' : 'false'}
              data-search-text={`${item.name} ${t(item.description, lang)}`.toLowerCase()}
            >
              <div class="min-w-0 flex-1">
                <h3 class="menu-item-name font-display font-semibold" style="color: var(--color-text-primary)">
                  {item.name}
                  {item.popular && (
                    <span class="text-[10px] font-bold uppercase ms-2 align-middle" style="color: var(--color-accent)" title={t(copy.pizzaPopularBadge, lang)}>
                      ★ {t(copy.pizzaPopularBadge, lang)}
                    </span>
                  )}
                  {item.vegetarian && <span class="text-xs align-middle" title={t(common.vegetarienUniquement, lang)}>🌱</span>}
                </h3>
                <p class="text-sm mt-1" style="color: var(--color-text-muted)">{t(item.description, lang)}</p>
              </div>
              <span class="menu-item-price font-bold shrink-0" style="color: var(--color-accent)">{item.priceMAD} MAD</span>
            </div>
          ))}
        </div>
      </section>
    </div>
  ))}

  <!-- Empty-state — shown when a search + filter combination matches
       nothing, so the page doesn't just look broken/blank. -->
  <p id="menu-empty-state" class="hidden max-w-7xl mx-auto px-5 sm:px-8 pb-16 text-center text-sm" style="color: var(--color-text-muted)">
    {t(common.aucunResultatMenu, lang)}
  </p>

  <Ornament />
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 text-center">
    <p class="text-sm mb-4" style="color: var(--color-text-muted)">{t(copy.readyToOrder, lang)}</p>
    <Button href={orderCtaLabel.href} external variant="cta">{orderCtaLabel.label}</Button>
  </section>
</Layout>

<style>
  .menu-filter-btn {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background-color: transparent;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  .menu-filter-btn.is-active {
    color: var(--color-background);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .menu-filter-btn:not(.is-active):hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>

<script>
  // Client-side only, no reload — see the search+filter section's comment
  // above for why this exists (and why it actually filters, unlike the
  // reference site's own decorative category pills). Three inputs combine
  // with AND: category pill (exclusive, "all" clears it), the vegetarian
  // toggle, and the free-text search box (matches item name + description,
  // via each card's own data-search-text). Wrapped in 'astro:page-load'
  // (same pattern as Layout.astro's sitewide scripts) so this
  // re-initializes correctly on a View Transitions client-side navigation,
  // not just a hard load.
  document.addEventListener('astro:page-load', () => {
    const catButtons = document.querySelectorAll<HTMLButtonElement>('[data-cat-filter]');
    const vegToggle = document.querySelector<HTMLButtonElement>('[data-veg-toggle]');
    const searchInput = document.querySelector<HTMLInputElement>('#menu-search');
    const emptyState = document.querySelector<HTMLElement>('#menu-empty-state');
    if (!catButtons.length) return;

    const categories = document.querySelectorAll<HTMLElement>('[data-menu-category]');

    let activeCategory = 'all';
    let vegOnly = false;

    function applyFilters() {
      const query = (searchInput?.value ?? '').trim().toLowerCase();
      let anyVisible = false;

      categories.forEach((cat) => {
        const catSlug = cat.getAttribute('data-category');
        const categoryMatches = activeCategory === 'all' || catSlug === activeCategory;
        let hasVisibleItem = false;

        cat.querySelectorAll<HTMLElement>('[data-menu-item]').forEach((item) => {
          const isVeg = item.getAttribute('data-veg') === 'true';
          const searchText = item.getAttribute('data-search-text') ?? '';
          const matches = categoryMatches && (!vegOnly || isVeg) && (!query || searchText.includes(query));
          item.style.display = matches ? '' : 'none';
          if (matches) hasVisibleItem = true;
        });

        cat.style.display = hasVisibleItem ? '' : 'none';
        if (hasVisibleItem) anyVisible = true;
      });

      if (emptyState) emptyState.classList.toggle('hidden', anyVisible);
    }

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.getAttribute('data-cat-filter') ?? 'all';
        catButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        applyFilters();
      });
    });

    vegToggle?.addEventListener('click', () => {
      vegOnly = !vegOnly;
      vegToggle.classList.toggle('is-active', vegOnly);
      applyFilters();
    });

    searchInput?.addEventListener('input', applyFilters);

    applyFilters();
  });
</script>
