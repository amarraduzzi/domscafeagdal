  <style>
    .testimonial-track { position: relative; min-height: 220px; }
    .testimonial-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.5s ease, transform 0.5s ease;
      pointer-events: none;
    }
    .testimonial-slide.is-active {
      position: relative;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .testimonial-dot.is-active { background-color: var(--color-accent) !important; width: 22px; }
  </style>

  <script>
    // Wrapped in 'astro:page-load' like every other script on this site
    // (see Layout.astro/Header.astro's comments) — Layout.astro enables
    // View Transitions sitewide, so a plain module script here only ever
    // ran on a hard page refresh, never on a client-side navigation TO the
    // home page (the normal way a visitor arrives via the nav bar). That
    // left every slide stuck at its default opacity:0/absolute state and
    // every dot un-highlighted — exactly the "empty" carousel this fixes.
    // The `data-wired` guard mirrors ReservationContent.astro's form guard
    // so repeated soft-navigations to Home don't stack up duplicate
    // setInterval timers on the same carousel.
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll<HTMLElement>('.testimonial-carousel').forEach((carousel) => {
        if (carousel.dataset.wired === 'true') return;
        carousel.dataset.wired = 'true';

        const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.testimonial-slide'));
        const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.testimonial-dot'));
        let active = 0;
        let timer: ReturnType<typeof setInterval>;

        function show(index: number) {
          active = (index + slides.length) % slides.length;
          slides.forEach((s, i) => s.classList.toggle('is-active', i === active));
          dots.forEach((d, i) => d.classList.toggle('is-active', i === active));
        }
        function start() {
          timer = setInterval(() => show(active + 1), 6000);
        }
        dots.forEach((dot, i) => {
          dot.addEventListener('click', () => {
            show(i);
            clearInterval(timer);
            start();
          });
        });
        show(0);
        start();
      });

      // Bombay Lounge video: unmute once it's actually in view, mute again
      // once it scrolls back out — see the comment above the <video> tag.
      // The `data-wired` guard matches the carousel's own, so a soft
      // navigation back to Home doesn't stack up duplicate observers on
      // the same video element.
      document.querySelectorAll<HTMLVideoElement>('#bombay-video').forEach((video) => {
        if (video.dataset.wired === 'true') return;
        video.dataset.wired = 'true';

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              // Some browsers refuse a scripted unmute outright; that's fine
              // — the video just stays muted and the native controls (kept
              // on for exactly this) let the visitor unmute it themselves.
              video.muted = !entry.isIntersecting;
            });
          },
          { threshold: 0.6 }
        );
        observer.observe(video);
      });

      // Stamp "thud" — a short, synthesized impact sound (low thump +
      // filtered paper-tap noise burst) timed to the moment PizzaBadge's
      // stamp actually lands. Home no longer has an oven-door reveal in
      // front of it (that theatrical door is /pizza-only now — see the
      // hero markup comment above), so the badge here renders with the
      // `immediate` prop and slams down almost at once; this timeout is
      // retimed to match that fast entrance instead of the old ~2.1s
      // door-synced one. Generated with the Web Audio API rather than an
      // audio file — nothing to host, nothing to fetch.
      //
      // Browsers block audio from playing before the visitor has
      // interacted with the page at all (autoplay policy, not something
      // this can work around) — so on a completely fresh, click-free
      // first load the very first play can stay silent; it plays
      // normally on any later navigation or once the visitor has clicked
      // anything on the page. `data-wired` mirrors the carousel/video
      // guards above so a soft navigation back to Home doesn't stack up
      // duplicate timers.
      document.querySelectorAll<HTMLElement>('#home-hero').forEach((hero) => {
        if (hero.dataset.stampSoundWired === 'true') return;
        hero.dataset.stampSoundWired = 'true';

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        function playStampThud() {
          try {
            const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
            const ctx = new AudioCtx();
            const now = ctx.currentTime;

            // Low thump
            const osc = ctx.createOscillator();
            const oscGain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(180, now);
            osc.frequency.exponentialRampToValueAtTime(58, now + 0.13);
            oscGain.gain.setValueAtTime(0.0001, now);
            oscGain.gain.exponentialRampToValueAtTime(0.55, now + 0.01);
            oscGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.24);
            osc.connect(oscGain).connect(ctx.destination);
            osc.start(now);
            osc.stop(now + 0.26);

            // Papery tap: a short burst of filtered noise on top of the
            // thump, so it reads as rubber-on-paper rather than a drum hit.
            const bufferSize = Math.floor(ctx.sampleRate * 0.08);
            const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
              data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
            }
            const noise = ctx.createBufferSource();
            noise.buffer = buffer;
            const noiseFilter = ctx.createBiquadFilter();
            noiseFilter.type = 'bandpass';
            noiseFilter.frequency.value = 1200;
            const noiseGain = ctx.createGain();
            noiseGain.gain.setValueAtTime(0.32, now);
            noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
            noise.connect(noiseFilter).connect(noiseGain).connect(ctx.destination);
            noise.start(now);
          } catch {
            // Web Audio unavailable/blocked — the visual stamp still
            // lands fine without it.
          }
        }

        // Hardcoded to match PizzaBadge.astro's `immediate`-mode
        // impact-flash/ring delay (0.3s) rather than reading the CSS —
        // same trade-off as before, just retimed for the fast entrance
        // now that there's no door to sync against on this page.
        window.setTimeout(playStampThud, 300);
      });
    });
  </script>
