  <style>
    .testimonial-track { position: relative; min-height: 220px; }
    .testimonial-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.5s ease, transform 0.5s ease;
      pointer-events: none;
    }
    .testimonial-slide.is-active {
      position: relative;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .testimonial-dot.is-active { background-color: var(--color-accent) !important; width: 22px; }
  </style>

  <script>
    // Wrapped in 'astro:page-load' like every other script on this site
    // (see Layout.astro/Header.astro's comments) — Layout.astro enables
    // View Transitions sitewide, so a plain module script here only ever
    // ran on a hard page refresh, never on a client-side navigation TO the
    // home page (the normal way a visitor arrives via the nav bar). That
    // left every slide stuck at its default opacity:0/absolute state and
    // every dot un-highlighted — exactly the "empty" carousel this fixes.
    // The `data-wired` guard mirrors ReservationContent.astro's form guard
    // so repeated soft-navigations to Home don't stack up duplicate
    // setInterval timers on the same carousel.
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll<HTMLElement>('.testimonial-carousel').forEach((carousel) => {
        if (carousel.dataset.wired === 'true') return;
        carousel.dataset.wired = 'true';

        const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.testimonial-slide'));
        const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.testimonial-dot'));
        let active = 0;
        let timer: ReturnType<typeof setInterval>;

        function show(index: number) {
          active = (index + slides.length) % slides.length;
          slides.forEach((s, i) => s.classList.toggle('is-active', i === active));
          dots.forEach((d, i) => d.classList.toggle('is-active', i === active));
        }
        function start() {
          timer = setInterval(() => show(active + 1), 6000);
        }
        dots.forEach((dot, i) => {
          dot.addEventListener('click', () => {
            show(i);
            clearInterval(timer);
            start();
          });
        });
        show(0);
        start();
      });

      // Bombay Lounge video: unmute once it's actually in view, mute again
      // once it scrolls back out — see the comment above the <video> tag.
      // The `data-wired` guard matches the carousel's own, so a soft
      // navigation back to Home doesn't stack up duplicate observers on
      // the same video element.
      document.querySelectorAll<HTMLVideoElement>('#bombay-video').forEach((video) => {
        if (video.dataset.wired === 'true') return;
        video.dataset.wired = 'true';

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              // Some browsers refuse a scripted unmute outright; that's fine
              // — the video just stays muted and the native controls (kept
              // on for exactly this) let the visitor unmute it themselves.
              video.muted = !entry.isIntersecting;
            });
          },
          { threshold: 0.6 }
        );
        observer.observe(video);
      });

      // Stamp "thud" — a short, synthesized impact sound (low thump +
      // filtered paper-tap noise burst) timed to the moment PizzaBadge's
      // stamp actually lands (see its stamp-slam/impact-ring delays,
      // retimed alongside the hero door's new slower 1.7s open so the two
      // still land together). Generated with the Web Audio API rather
      // than an audio file — nothing to host, nothing to fetch.
      //
      // Browsers block audio from playing before the visitor has
      // interacted with the page at all (autoplay policy, not something
      // this can work around) — so on a completely fresh, click-free
      // first load the very first play can stay silent; it plays
      // normally on any later navigation or once the visitor has clicked
      // anything on the page. `data-wired` mirrors the carousel/video
      // guards above so a soft navigation back to Home doesn't stack up
      // duplicate timers.
      document.querySelectorAll<HTMLElement>('#home-hero').forEach((hero) => {
        if (hero.dataset.stampSoundWired === 'true') return;
        hero.dataset.stampSoundWired = 'true';

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        function playStampThud() {
          try {
            const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
            const ctx = new AudioCtx();
            const now = ctx.currentTime;

            // Low thump
            const osc = ctx.createOscillator();
            const oscGain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(180, now);
            osc.frequency.exponentialRampToValueAtTime(58, now + 0.13);
            oscGain.gain.setValueAtTime(0.0001, now);
            oscGain.gain.exponentialRampToValueAtTime(0.55, now + 0.01);
            oscGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.24);
            osc.connect(oscGain).connect(ctx.destination);
            osc.start(now);
            osc.stop(now + 0.26);

            // Papery tap: a short burst of filtered noise on top of the
            // thump, so it reads as rubber-on-paper rather than a drum hit.
            const bufferSize = Math.floor(ctx.sampleRate * 0.08);
            const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
              data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
            }
            const noise = ctx.createBufferSource();
            noise.buffer = buffer;
            const noiseFilter = ctx.createBiquadFilter();
            noiseFilter.type = 'bandpass';
            noiseFilter.frequency.value = 1200;
            const noiseGain = ctx.createGain();
            noiseGain.gain.setValueAtTime(0.32, now);
            noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
            noise.connect(noiseFilter).connect(noiseGain).connect(ctx.destination);
            noise.start(now);
          } catch {
            // Web Audio unavailable/blocked — the visual stamp still
            // lands fine without it.
          }
        }

        // Hardcoded to match PizzaBadge.astro's impact-ring delay (2.15s)
        // rather than reading the CSS — same trade-off as the rest of
        // this hero's choreography (see the HomeContent.astro/
        // PizzaBadge.astro comments on the door-open/stamp-slam timing).
        window.setTimeout(playStampThud, 2150);
      });
    });
  </script>
</Layout>

<style>
  /* See the comment above #home-hero in the markup: this has to live here
     (not as a Tailwind class) so it doesn't out-specificity the
     sm:h-[92vh] desktop height, and so the 100vh/100svh fallback works as
     two real separate declarations. */
  @media (max-width: 639px) {
    #home-hero {
      height: 100vh;
      height: 100svh;
    }
  }

  /* ============================================================================
     "Whole hero is the oven" door — see the comment above .oven-doors-big
     in the markup. #home-hero needs its own `perspective` so the door
     panel rotates in 3D relative to the hero itself (its parent), not the
     whole page. Single top-hinged stainless panel (rotateX) — the
     previous version's two side-hinged cabinet doors (rotateY) are gone;
     a real pizza-deck oven door is one flat metal panel, one handle,
     hinged at the top, per the client's own reference photos.
     ============================================================================ */
  #home-hero {
    perspective: 2200px;
  }
  .oven-doors-big {
    position: absolute;
    inset: 0;
    z-index: 50;
    pointer-events: none;
  }
  .oven-glow-big {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(255, 170, 80, 0.95) 0%, rgba(200, 100, 30, 0.5) 42%, transparent 72%);
    opacity: 0;
    animation: hero-glow-flash 1s ease-out 0.15s both;
  }

  /* Brushed stainless steel panel: a base metal gradient plus two overlay
     layers — a fine repeating vertical hairline texture (the brushed
     grain) and a soft diagonal band of highlights (the specular sheen
     real stainless catches under light, see the reference photos) —
     instead of a flat tint, so it actually reads as metal rather than a
     grey rectangle. Hinged along the TOP edge (transform-origin) and
     rotated with rotateX so it swings up and back like a real oven door
     lid, not sideways like a cabinet door. */
  .oven-door-steel {
    position: absolute;
    inset: 0;
    transform-origin: top center;
    background:
      linear-gradient(
        100deg,
        rgba(255, 255, 255, 0.4) 0%,
        transparent 14%,
        transparent 38%,
        rgba(255, 255, 255, 0.3) 47%,
        transparent 56%,
        transparent 80%,
        rgba(255, 255, 255, 0.22) 92%,
        transparent 100%
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.07) 0px,
        rgba(255, 255, 255, 0.07) 1px,
        transparent 1px,
        transparent 3px
      ),
      linear-gradient(160deg, #e9ebed 0%, #c4c7cc 28%, #f0f1f2 45%, #a7abb1 64%, #d8dadd 100%);
    box-shadow: inset 0 0 70px rgba(0, 0, 0, 0.28);
    backface-visibility: hidden;
    /* Slowed from 1.15s to 1.7s per client feedback ("iets langzamer") —
       see the PizzaBadge.astro comment for how its stamp timing was
       retimed to match this new, later completion (~2.05s). */
    animation: hero-door-open 1.7s cubic-bezier(0.7, 0, 0.3, 1) 0.35s both;
  }
  .oven-door-steel-hinge-shadow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35), transparent);
  }

  /* The single black D-handle — the one thing on the door that isn't
     metal, so it reads immediately as "the part you grab", same as every
     real oven-door handle in the reference photos. Two small brackets
     hold a glossy black bar off the surface, with its own drop shadow
     for a bit of real depth instead of a flat painted stripe. */
  .oven-door-handle {
    position: absolute;
    left: 50%;
    top: 60%;
    transform: translate(-50%, -50%);
    width: 34%;
    min-width: 160px;
    height: 6%;
    min-height: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2%;
  }
  .oven-door-handle-bracket {
    width: 8%;
    min-width: 14px;
    height: 150%;
    background: linear-gradient(180deg, #9a9da3, #6c6f74);
    border-radius: 3px;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.35);
  }
  .oven-door-handle-bar {
    flex: 1;
    height: 100%;
    background: linear-gradient(180deg, #3a3a3c 0%, #1c1c1e 45%, #050505 100%);
    border-radius: 9999px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.55), inset 0 1px 1px rgba(255, 255, 255, 0.3);
  }

  @keyframes hero-door-open {
    0% { transform: rotateX(0deg); }
    100% { transform: rotateX(-112deg); }
  }
  @keyframes hero-glow-flash {
    0% { opacity: 0; }
    40% { opacity: 1; }
    70% { opacity: 0.35; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .oven-glow-big {
      display: none;
    }
    .oven-door-steel {
      animation: none;
      transform: rotateX(-112deg);
      opacity: 0;
    }
  }
</style>
