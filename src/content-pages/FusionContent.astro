---
// NEW dedicated Fusion page (client request, 27/09/2026) — replaces the old
// dedicated /pizza page entirely (that page's own oven-door hero, "pizza à
// la part" concept and 7-pizza showcase are gone, not reused: this is a
// brand-new product line, not a variant of the round pizza menu). Fusion is
// its own thing: rectangular 10x15cm pizzas with unexpected pairings, plus a
// "coming soon" teaser for Msemen Pasta (still being tested in the kitchen —
// no order CTA on that teaser, on purpose, since it isn't sellable yet).
//
// The classic round pizzas (pizza-showcase.ts, PizzaShowcaseGrid.astro) are
// untouched — they still live on Home's teaser section and on /menu#pizzas.
// Only the URL and nav slot that used to be the round pizza's own dedicated
// page now points here instead (see Header.astro, HomeContent.astro).
//
// Hero has its own theatrical reveal too (client asked for something that
// immediately grabs attention on open — see chat, 27/09/2026), but built as
// a "box lid" opening rather than reusing PizzaBadge's oven-door: same 3D
// rotateX technique, deliberately different visual object (a Fusion
// takeaway box, not an oven), so the two products don't blur together. See
// the <style> block at the bottom of this file for the mechanism.
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Ornament from '../components/Ornament.astro';
import { siteConfig } from '../config/site.config';
import { getOrderCtaLabel } from '../lib/nav';
import { fusionShowcase } from '../content/fusion-showcase';
import { t, localizedPath, arrow, type Language } from '../i18n/languages';
import { place } from '../i18n/ui';

interface Props {
  lang?: Language;
}
const { lang = 'fr' } = Astro.props;

const { name } = siteConfig.identity;
const city = t(place.city, lang);
const orderCtaLabel = getOrderCtaLabel(lang);

const copy = {
  metaTitle: {
    fr: `Fusion by Dom's — pizzas rectangulaires | ${name}`,
    en: `Fusion by Dom's — rectangular pizzas | ${name}`,
    ar: `Fusion by Dom's — بيتزا مستطيلة | ${name}`,
  },
  metaDescription: {
    fr: `Fusion by Dom's, le nouveau concept de ${name} à Agdal, ${city} : pizzas rectangulaires 10x15cm aux saveurs inattendues. Bientôt : notre Msemen Pasta.`,
    en: `Fusion by Dom's, the new concept from ${name} in Agdal, ${city}: rectangular 10x15cm pizzas with unexpected flavors. Coming soon: our Msemen Pasta.`,
    ar: `Fusion by Dom's، المفهوم الجديد من ${name} بأكدال، ${city}: بيتزا مستطيلة بمقاس 10x15 سم بنكهات غير متوقعة. قريبًا: مسمن باستا.`,
  },
  kicker: { fr: "Notre nouveau concept", en: 'Our new concept', ar: 'مفهومنا الجديد' },
  heroTitle: { fr: "Fusion by Dom's", en: "Fusion by Dom's", ar: "Fusion by Dom's" },
  heroSubtitle: {
    fr: "Des pizzas rectangulaires 10x15cm, où les classiques italiens rencontrent des saveurs venues d'ailleurs.",
    en: 'Rectangular 10x15cm pizzas, where Italian classics meet flavors from elsewhere.',
    ar: 'بيتزا مستطيلة الشكل بمقاس 10x15 سم، حيث يلتقي الطراز الإيطالي الكلاسيكي بنكهات من أماكن أخرى.',
  },
  heroCtaSecondary: { fr: 'Découvrir les 4 créations', en: 'Discover the 4 creations', ar: 'اكتشف الإبداعات الأربعة' },

  conceptTitle: { fr: 'Le concept', en: 'The concept', ar: 'المفهوم' },
  // Big editorial pull-quote, split in 3 so the middle part can be rendered
  // in the accent color (client asked for the concept section to have real
  // "wow factor" instead of being three identical text-only cards — see
  // chat, 27/09/2026, option 2 of 3 explored: big statement + photo-backed
  // feature cards, chosen specifically because it degrades to full-width
  // stacked cards on mobile without losing impact, unlike the other two
  // options discussed).
  conceptQuotePre: { fr: 'Manger, c\'est ', en: 'Food should be ', ar: 'الأكل ' },
  conceptQuoteHighlight: { fr: 'un voyage de découverte', en: 'a journey of discovery', ar: 'رحلة اكتشاف' },
  conceptQuotePost: { fr: '.', en: '.', ar: '.' },
  conceptManifesto: {
    fr: "Manger ne devrait jamais être une routine. Chez Dom's, Fusion est notre façon de remettre en question l'évidence : des produits frais, préparés autrement, sous une toute nouvelle forme. On voit trop souvent les mêmes recettes recopiées partout à Agdal — ici, chaque création part d'une vraie idée, pas d'une habitude.",
    en: "Eating shouldn't be routine. At Dom's, Fusion is our way of questioning the obvious: fresh ingredients, prepared differently, given a whole new shape. We see the same recipes copied everywhere in Agdal — here, every creation starts from a real idea, not a habit.",
    ar: 'الأكل يجب ألا يكون روتينًا. في Dom\'s، فيوجن هي طريقتنا لإعادة النظر فيما هو مألوف: مكونات طازجة، محضّرة بطريقة مختلفة، وبشكل جديد كليًا. نرى نفس الوصفات تتكرر في كل مكان بأكدال، أما هنا فكل إبداع ينطلق من فكرة حقيقية لا من عادة.',
  },
  conceptIntro: {
    fr: "Fusion, c'est notre façon de revisiter un format connu avec des associations qu'on ne trouve pas ailleurs à Agdal. Ici, la pizza change de forme : rectangulaire, 10x15cm, avec une garniture qui va chercher plus loin que la carte classique.",
    en: "Fusion is our way of reinventing a familiar format with combinations you won't find anywhere else in Agdal. Here, pizza changes shape: rectangular, 10x15cm, topped with flavors that go further than our usual menu.",
    ar: 'فيوجن هي طريقتنا لإعادة ابتكار شكل معروف بمزيج نكهات لا تجدونها في مكان آخر بأكدال. هنا، يتغير شكل البيتزا: مستطيلة بمقاس 10x15 سم، بمكونات تذهب أبعد من القائمة الكلاسيكية.',
  },
  feature1Title: { fr: 'Un format signature', en: 'A signature format', ar: 'شكل مميز' },
  feature1Desc: {
    fr: 'Chaque pizza Fusion mesure 10x15cm, cuite au four, avec une pâte fine qui reste croustillante jusqu\'à la dernière bouchée.',
    en: 'Every Fusion pizza measures 10x15cm, oven-baked, with a thin crust that stays crisp to the last bite.',
    ar: 'كل بيتزا فيوجن بمقاس 10x15 سم، تُخبز في الفرن، بعجينة رقيقة تبقى مقرمشة حتى آخر قضمة.',
  },
  feature2Title: { fr: 'Des associations inattendues', en: 'Unexpected pairings', ar: 'مزيج نكهات غير متوقع' },
  feature2Desc: {
    fr: "Miel piquant, stracciatella, merguez, pesto : chaque création marie des ingrédients qu'on n'associe pas d'habitude sur une pizza.",
    en: "Spicy honey, stracciatella, merguez, pesto: every creation pairs ingredients you wouldn't usually find together on a pizza.",
    ar: 'عسل حار، ستراتشاتيلا، مرقاز، بيستو: كل إبداع يجمع بين مكونات لا نعتاد رؤيتها معًا على بيتزا واحدة.',
  },
  feature3Title: { fr: 'Toujours une nouveauté en préparation', en: 'Always something new in the works', ar: 'دائمًا جديد قيد التحضير' },
  feature3Desc: {
    fr: "Fusion ne s'arrête pas à 4 pizzas : on teste, on goûte, on recommence — la prochaine création est déjà en cuisine.",
    en: "Fusion doesn't stop at 4 pizzas: we test, we taste, we start again — the next creation is already in the kitchen.",
    ar: 'فيوجن لا تتوقف عند 4 أنواع بيتزا: نجرّب، نتذوق، نعيد المحاولة، الإبداع القادم موجود بالفعل في مطبخنا.',
  },

  creationsTitle: { fr: 'Nos 4 créations', en: 'Our 4 creations', ar: 'إبداعاتنا الأربعة' },
  creationsIntro: {
    fr: 'Quatre recettes déjà au point, prêtes à être commandées.',
    en: 'Four recipes already perfected, ready to order.',
    ar: 'أربع وصفات جاهزة بالكامل، متوفرة للطلب الآن.',
  },
  orderThis: { fr: 'Commander', en: 'Order', ar: 'اطلب' },

  comingSoonBadge: { fr: 'Bientôt disponible', en: 'Coming soon', ar: 'قريبًا' },
  comingSoonTitle: { fr: 'Msemen Pasta', en: 'Msemen Pasta', ar: 'مسمن باستا' },
  comingSoonDesc: {
    fr: 'La prochaine étape de Fusion : le msemen marocain, réinventé en pâtes. Encore en test dans notre cuisine, cette création arrivera bientôt sur la carte.',
    en: 'The next step for Fusion: Moroccan msemen, reinvented as pasta. Still being tested in our kitchen, this creation is coming soon to the menu.',
    ar: 'الخطوة القادمة لفيوجن: المسمن المغربي بحلّة جديدة على شكل باستا. هذا الإبداع لا يزال قيد التجربة في مطبخنا، وسيصل قريبًا إلى القائمة.',
  },
  comingSoonVariant1: { fr: 'Chicken Cream', en: 'Chicken Cream', ar: 'كريمة الدجاج' },
  comingSoonVariant2: { fr: 'Spicy', en: 'Spicy', ar: 'حارة' },

  readyToOrder: { fr: 'Prêt à découvrir Fusion ?', en: 'Ready to try Fusion?', ar: 'جاهز لتجربة فيوجن؟' },
} satisfies Record<string, { fr: string; en: string; ar: string }>;

const fusionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Fusion by Dom's — ${name}`,
  hasMenuSection: [
    {
      '@type': 'MenuSection',
      name: "Fusion by Dom's",
      hasMenuItem: fusionShowcase.map((item) => ({
        '@type': 'MenuItem',
        name: item.name,
        description: t(item.description, lang),
        offers: { '@type': 'Offer', price: item.priceMAD, priceCurrency: 'MAD' },
      })),
    },
  ],
};

const path = localizedPath('/fusion', lang);
---
<Layout
  title={t(copy.metaTitle, lang)}
  description={t(copy.metaDescription, lang)}
  path={path}
  lang={lang}
  jsonLd={fusionJsonLd}
>
  <!-- Hero — "box reveal": a closed Fusion takeaway-box lid covers the whole
       hero on load and swings open (3D rotateX, same construction family as
       the classic pizza page's old oven-door reveal — see the <style> block
       below for the port), uncovering the video + headline underneath.
       Updated 27/09/2026: the client's own promo video now plays here
       instead of a static photo, so the reveal uncovers actual motion —
       still one single hero section rather than a separate video block
       further down the page (client's explicit call, having seen the real
       footage). Autoplay video must be muted (browsers block it otherwise,
       and audio firing the instant the box lid opens would be jarring
       regardless) — the small speaker button lets anyone turn the sound on. -->
  <section id="fusion-hero" class="relative overflow-hidden min-h-[480px] sm:h-[70vh] flex flex-col items-center justify-center text-center px-5 py-20">
    <video
      id="fusion-hero-video"
      src="/videos/fusion-promo.mp4"
      poster="/images/dom/fusion/gold.webp"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      class="absolute inset-0 w-full h-full object-cover"
    ></video>
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(10, 6, 3, 0.55) 0%, rgba(10, 6, 3, 0.75) 60%, var(--color-background) 100%)"></div>

    <!-- Sound toggle -- starts muted (required for autoplay), one tap turns
         the promo video's audio on or back off. Plain inline script: this
         is a static Astro page, no framework runtime to hook into here. -->
    <button
      id="fusion-hero-sound-toggle"
      type="button"
      aria-label="Activer le son"
      class="absolute z-10 top-4 right-4 rtl:right-auto rtl:left-4 w-10 h-10 rounded-full flex items-center justify-center transition-colors"
      style="background: rgba(10, 6, 3, 0.5); border: 1px solid rgba(243, 236, 221, 0.25); color: var(--color-text-primary); backdrop-filter: blur(4px)"
    >
      <svg data-icon="muted" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
      <svg data-icon="unmuted" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>
    </button>

    <!-- Closed box lid — covers the whole hero at load, then swings open
         from a top hinge. Pure CSS (gradient + border), not a photo, same
         approach the old oven-door steel panel used. -->
    <div class="fusion-box-lid" aria-hidden="true">
      <div class="fusion-box-steam"></div>
      <div class="fusion-box-lid-panel">
        <div class="fusion-box-sticker">
          <span class="font-display font-black tracking-[0.18em] text-lg sm:text-2xl" style="color: var(--color-accent)">FUSION</span>
          <span class="font-display font-black tracking-[0.18em] text-lg sm:text-2xl" style="color: var(--color-accent)">BY DOM'S</span>
        </div>
      </div>
    </div>

    <span class="relative z-10 block text-[10px] font-bold uppercase tracking-[0.3em] mb-3" style="color: var(--color-accent)">{t(copy.kicker, lang)} · Agdal, {city}</span>
    <h1 class="relative z-10 font-display text-4xl sm:text-6xl font-semibold max-w-3xl" style="color: var(--color-text-primary); text-shadow: 0 2px 16px rgba(0, 0, 0, 0.6)">
      {t(copy.heroTitle, lang)}
    </h1>
    <p class="relative z-10 mt-4 max-w-xl text-sm sm:text-base" style="color: var(--color-text-primary); text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6)">
      {t(copy.heroSubtitle, lang)}
    </p>
    <div class="relative z-10 mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href={orderCtaLabel.href} external variant="filled">{orderCtaLabel.label}</Button>
      <Button href="#creations" variant="outline">{t(copy.heroCtaSecondary, lang)}</Button>
    </div>
  </section>

  <script>
    const video = document.getElementById('fusion-hero-video') as HTMLVideoElement | null;
    const toggle = document.getElementById('fusion-hero-sound-toggle');
    if (video && toggle) {
      const mutedIcon = toggle.querySelector('[data-icon="muted"]') as HTMLElement | null;
      const unmutedIcon = toggle.querySelector('[data-icon="unmuted"]') as HTMLElement | null;
      toggle.addEventListener('click', () => {
        video.muted = !video.muted;
        if (mutedIcon) mutedIcon.style.display = video.muted ? '' : 'none';
        if (unmutedIcon) unmutedIcon.style.display = video.muted ? 'none' : '';
        toggle.setAttribute('aria-label', video.muted ? 'Activer le son' : 'Couper le son');
      });
    }
  </script>

  <!-- Le concept -->
  <section class="section-tint-warm">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-16 sm:py-24">
      <div class="max-w-2xl mx-auto text-center mb-14" data-reveal>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold" style="color: var(--color-text-primary)">{t(copy.conceptTitle, lang)}</h2>
        <p class="mt-6 font-display text-2xl sm:text-4xl font-semibold leading-snug" style="color: var(--color-text-primary)">
          {t(copy.conceptQuotePre, lang)}<span style="color: var(--color-accent)">{t(copy.conceptQuoteHighlight, lang)}</span>{t(copy.conceptQuotePost, lang)}
        </p>
        <p class="mt-6 text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)">{t(copy.conceptManifesto, lang)}</p>
        <p class="mt-4 text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)">{t(copy.conceptIntro, lang)}</p>
      </div>

      <!-- Photo-backed feature cards, not plain text-only cards — each
           photo directly illustrates its point (rectangular shape / the
           merguez pairing / the Msemen Pasta teaser for "always something
           new") instead of a generic numbered circle. Stacks to full-width
           cards on mobile, each photo staying large rather than shrinking
           into a collage — see chat, 27/09/2026 on why this option was
           picked specifically for how it degrades on mobile. -->
      <div class="grid sm:grid-cols-3 gap-6 sm:gap-8">
        {[
          { title: copy.feature1Title, desc: copy.feature1Desc, image: '/images/dom/fusion/red.webp' },
          { title: copy.feature2Title, desc: copy.feature2Desc, image: '/images/dom/fusion/gold.webp' },
          { title: copy.feature3Title, desc: copy.feature3Desc, image: '/images/dom/fusion/msemen-pasta.webp' },
        ].map((f, i) => (
          <div
            class="card-lift relative rounded-2xl overflow-hidden aspect-[4/5] sm:aspect-[3/4]"
            style={`border: 1px solid var(--color-border); transition-delay: ${i * 90}ms`}
            data-reveal
          >
            <img src={f.image} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(10,6,3,0) 25%, rgba(10,6,3,0.92) 100%)"></div>
            <div class="relative z-10 h-full flex flex-col justify-end p-5">
              <h3 class="font-display font-semibold text-lg" style="color: #F3ECDD; text-shadow: 0 2px 10px rgba(0,0,0,0.7)">{t(f.title, lang)}</h3>
              <p class="mt-2 text-sm leading-relaxed" style="color: rgba(243,236,221,0.85); text-shadow: 0 1px 8px rgba(0,0,0,0.8)">{t(f.desc, lang)}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nos 4 créations -->
  <section id="creations" class="max-w-6xl mx-auto px-5 sm:px-8 py-16 sm:py-20">
    <div class="max-w-2xl mx-auto text-center mb-12" data-reveal>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold" style="color: var(--color-text-primary)">{t(copy.creationsTitle, lang)}</h2>
      <p class="mt-3 text-sm sm:text-base" style="color: var(--color-text-muted)">{t(copy.creationsIntro, lang)}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {fusionShowcase.map((item, i) => (
        <div
          class="card-lift relative rounded-2xl overflow-hidden"
          style={`background-color: var(--color-surface); border: 1px solid var(--color-border); transition-delay: ${i * 70}ms`}
          data-reveal
        >
          <div class="photo-frame aspect-[3/4]">
            <img src={item.image} alt={t(item.imageAlt, lang)} class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="p-5">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="menu-item-name font-display font-semibold text-lg" style="color: var(--color-text-primary)">{item.name}</h3>
              <span class="menu-item-price shrink-0 font-bold text-base" style="color: var(--color-accent)">{item.priceMAD} MAD</span>
            </div>
            <p class="text-sm mt-2 leading-relaxed" style="color: var(--color-text-muted)">{t(item.description, lang)}</p>
            <div class="mt-4">
              <Button href={orderCtaLabel.href} external variant="outline" class="w-full !py-2 !text-xs">{t(copy.orderThis, lang)}</Button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Bientôt : Msemen Pasta — teaser only, no order CTA (not sellable yet,
       still being tested in the kitchen — see chat, 27/09/2026). Deliberately
       vague on texture/taste claims, since nothing is confirmed yet. The two
       photos are AI-generated concept renders (client's own, see chat) —
       NOT real product photography yet, hence no price and no "Commander"
       button anywhere in this section, unlike the 4 real creations above. -->
  <section class="section-tint-warm">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 py-16 sm:py-20">
      <div class="max-w-2xl mx-auto text-center mb-10" data-reveal>
        <span
          class="inline-flex items-center gap-1.5 mb-5 px-3 py-1.5 rounded-full text-xs font-bold"
          style="border: 1px solid var(--color-border); color: var(--color-accent); background-color: color-mix(in srgb, var(--color-accent) 12%, transparent)"
        >
          {t(copy.comingSoonBadge, lang)}
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold" style="color: var(--color-text-primary)">{t(copy.comingSoonTitle, lang)}</h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed" style="color: var(--color-text-muted)">{t(copy.comingSoonDesc, lang)}</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6 sm:gap-8 max-w-3xl mx-auto">
        {[
          { image: '/images/dom/fusion/msemen-pasta.webp', label: copy.comingSoonVariant1 },
          { image: '/images/dom/fusion/msemen-pasta-spicy.webp', label: copy.comingSoonVariant2 },
        ].map((variant, i) => (
          <div class="relative rounded-2xl overflow-hidden aspect-[3/4]" style={`border: 1px solid var(--color-border); transition-delay: ${i * 90}ms`} data-reveal>
            <img src={variant.image} alt={`Msemen Pasta ${t(variant.label, lang)}`} class="w-full h-full object-cover" loading="lazy" />
            <span
              class="absolute bottom-3 rtl:right-3 ltr:left-3 px-2.5 py-1 rounded-full text-[11px] font-bold"
              style="background-color: color-mix(in srgb, black 55%, transparent); color: var(--color-text-primary); backdrop-filter: blur(4px)"
            >
              {t(variant.label, lang)}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Ornament />
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-16 text-center">
    <p class="text-sm mb-4" style="color: var(--color-text-muted)">{t(copy.readyToOrder, lang)}</p>
    <Button href={orderCtaLabel.href} external variant="filled">{orderCtaLabel.label} {arrow(lang)}</Button>
  </section>
</Layout>

<style>
  /* ============================================================================
     Fusion hero "box reveal" — a closed takeaway-box lid covers the whole
     hero at load and swings open on a top hinge (3D rotateX), same family of
     technique as the classic pizza page's old oven-door reveal (steel panel,
     rotateX, glow flash on open) but re-skinned as a box lid with the Fusion
     wordmark printed on it, so it reads as its own thing rather than a copy
     of the pizza page's device. Client explicitly picked this over a photo
     carousel / title-fuse animation / scroll-build / background video (see
     chat, 27/09/2026). */
  #fusion-hero {
    perspective: 2200px;
  }
  .fusion-box-lid {
    position: absolute;
    inset: 0;
    z-index: 50;
    pointer-events: none;
  }
  .fusion-box-steam {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 55%, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.3) 32%, transparent 66%);
    filter: blur(6px);
    opacity: 0;
    animation: fusion-steam-puff 1.2s ease-out 0.55s both;
  }
  .fusion-box-lid-panel {
    position: absolute;
    inset: 0;
    transform-origin: top center;
    background:
